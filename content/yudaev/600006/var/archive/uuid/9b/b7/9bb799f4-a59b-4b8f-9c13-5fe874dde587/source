#include <stdio.h>
#include <math.h>
int main (){
   int n,i,a,k,c1,c2,x,z1,z2;

   
   freopen ("input.txt", "rt", stdin);
   scanf ("%d",&n);
   fclose (stdin);

   a = 0;
   i = 1;
   while (a == 0) {
       i = i + 1;
       x = (i*(i+1))/2;
       c1 = 0;
       c2 = 0;
       if (i % 2 == 0) {
       	   z1 = i/2; z2 = i+1;
       } else {
       	   z1 = (i+1)/2; z2 = i;
       }
       
       for (k = 1; k*k <= z1; k++)
       {
       	   if ((z1 % k) == 0){
               c1 = c1 + 2;
               if (z1 == k * k)
                   c1 = c1 - 1;
           }
       }
       
       for (k = 1; k*k <= z2; k++)
       {
       	   if ((z2 % k) == 0){
               c2 = c2 + 2;
               if (z2 == k * k)
                  c2 = c2 - 1;
           }
       }
       
       if ((c1 * c2) > n){
           a = 1;
       }
           
   }
   freopen ("output.txt", "wt", stdout);
   printf ("%d", x);
   fclose (stdout);
   
   return 0;
}