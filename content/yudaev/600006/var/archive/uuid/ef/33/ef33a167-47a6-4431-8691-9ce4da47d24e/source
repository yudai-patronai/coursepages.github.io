#include <stdio.h>
#include <math.h>

int main(int argc, char* argv[], char* envp[])
{
	int i, n, p = 0, res = 0, div = 0, k1 = 0, k2 = 0;
	freopen("input.txt", "rt", stdin);
	scanf("%d", &n);
	fclose(stdin);
	while (div < n)
	{
		k1 = 0;
		k2 = 0;
		p++;
		res += p;
		for (i = 1; i <= sqrt(n); i++)
		{
			if (res % i == 0)
				k1++;
		}
		for (i = 1; i <= sqrt(n) + 1; i++)
		{
			if (res % i == 0)
				k2++;
		}
		div = k1 * k2;
	}
	freopen("output.txt", "wt", stdout);
	printf("%d", res);
	fclose(stdout);
    return 0;
}