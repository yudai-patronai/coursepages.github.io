#include <stdio.h>

int quan_prost(int n)
{
	int s=0, i=1;
	while((i*i)<n)
	{
		if((n % i)==0) 
			s += 2;
		i++;
	}
	if(n==(i*i)) 
		s++;
	if(n==1)
		s=1; 
	return s;
}

