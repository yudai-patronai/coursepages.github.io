#include<stdio.h>
int main(int arg,char * argv[], char *envp[]){
int i, n, n1, n2, ans, x = 0, y = 0;
if ( NULL == freopen("input.txt", "rt", stdin) ){
	printf("There are no input.txt here");
	return 1;
}
scanf("%d", &n);
fclose(stdin);
if ( NULL == freopen("output.txt", "wt", stdout)){
	printf("There are no output.txt here");
	return 2;
}
if ( n % 2 == 0){
	n2 = n / 2;
	n1 = n + 1;
}
else {
	n2 = ( n + 1 ) / 2;
	n1 = n;
}
for ( i = 1; i * i < n1; ++i){
	if (n1 % i == 0)
		x += 2;
	}
	if ( n1 % i == 0)
	x += 1;
for ( i = 1; i * i < n2; ++i){
	if (n2 % i == 0)
		y += 2;
	}
	if ( n2 % i == 0)
	y += 1;
	ans = x * y;
printf("%d", ans);
fclose(stdout);
return 0;
}
