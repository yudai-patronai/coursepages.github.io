#include <stdio.h>
#include <stdlib.h>

int divisors(int a)
{
        int r = 1;
        int i;
        for(i = 2; i <= a; i++)
                if(!(a % i))
                {
                        int p = 1;
                        while(!(a % i))
                        {
                                p++;
                                a /= i;
                        }
                        r *= p;
                }
        return r;
}

int main(int argc, char *argv[])
{
        freopen("input.txt", "r", stdin);
        freopen("output.txt", "w", stdout);
        int N, i, j;
        scanf("%d", &N);
        int tri = 0;
        for(i = 1; ;i++)
        {
                tri += i;
                if(divisors(tri) > N)
                {
                        printf("%d\n", tri);
                        return 0;
                }
        }
}
