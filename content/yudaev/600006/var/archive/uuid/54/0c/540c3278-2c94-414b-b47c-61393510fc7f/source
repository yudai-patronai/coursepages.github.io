#include <stdio.h>
#include <string.h>
#include <stdlib.h>
#include <stdio.h>

int main(int n, char** a)
{
    int i, s;
    s = 0;
    if (n != 1)
        {
            for (i = 0; i < n; i++)
            {
                s = s + atoi(a[i]);
            }
            //printf("%d", s);
            return s;
        }
    else
        return 0;
}
