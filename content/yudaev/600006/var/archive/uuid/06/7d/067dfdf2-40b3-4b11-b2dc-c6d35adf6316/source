#include <stdlib.h>
#include <stdio.h>
#include <math.h>
int col_del(long n) {
	long i, k = 0;
	for (i = 1; i*i < n; i++)
		if (n % i == 0)
			k += 2;
	if ((i+1)*(i+1))
		k += 1;
	return (k);
}
int main() {
	//FILE *f1 = fopen("input.txt", "r");
	int n;
	//fscanf(f1, "%d", &n);
	scanf("%d", &n);
	int a, b, na, nb;
	na = 1;
	nb = 2;
	a = 1;
	b = 2;
	while ((a*b) <= 2*n) {
		na = nb;
		a = b;
		nb++;
		b = col_del(nb);;
	}
	//fclose(f1);
	//FILE *f2 = fopen("output.txt", "w");
	//fprintf (f2, "%ld\n", sum);
	printf ("%d\n", (na*nb) / 2);
	//fclose(f2);
	return 0;
}