#include <stdio.h>
int main() {
int a, b,  i, j, n, k1 = 0, k2 = 0;
freopen("input.txt", "rt", stdin);
scanf("%d", &n);
fclose(stdin);
for( i = n; k1 * k2 <= n; i++)
{
a = i % 2 ? (i + 1) / 2: i / 2;
b = i % 2 ? i: i + 1;
for (j = 1; j * j < a; j++)
        if (!(a % j))
                k1 += 2;
j++;
if (j * j == a)
        k1++;
for (j = 1; j * j < b; j++)
        if (!(b % j))
                k2 += 2;
j++;
if (j * j == a)
        k2++;
}
freopen("output.txt", "wt", stdout);
printf("%d", (i + 1) * i / 2);
fclose(stdout);
return 0;
}
