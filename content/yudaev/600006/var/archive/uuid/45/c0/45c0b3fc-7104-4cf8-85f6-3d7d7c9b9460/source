#include <stdio.h>

int main(int argc, char *argv[], char *envp[])
{
	freopen("input.txt", "rt", stdin);
	freopen("output.txt", "wt", stdout);
	int l=0, d=0;
	int n1 = 1, n2 = 1;
	int i = 0, j=0;
	scanf("%d", &l);
	for(i=2;d<=l;i++)
	{
		n1=0;
		n2=0;
		if (i%2==0)
		{
			for(j=1;j*j<i/2;j++)
			{
				if((i/2)%j==0) n2=n2+2;
			}
			if(j*j==i/2) n2++;
			for(j=1;j*j<i-1;j++)
			{
				if((i-1)%j==0) n1=n1+2;
			}
			if(j*j==i-1) n1++;
		}
		else
		{
			for(j=1;j*j<i;j++)
			{
				if(i%j==0) n2=n2+2;
			}
			if(j*j==i) n2++;
			for(j=1;j*j<(i-1)/2;j++)
			{
				if(((i-1)/2)%j==0) n1=n1+2;
			}
			if(j*j==(i-1)/2) n1++;
		}
		d=n1*n2;
		//printf("%d\n", d);
	}
	printf("%d", (i-2)*(i-1)/2);
	
	
	fclose(stdout);
	fclose(stdin);
	return 0;
}


