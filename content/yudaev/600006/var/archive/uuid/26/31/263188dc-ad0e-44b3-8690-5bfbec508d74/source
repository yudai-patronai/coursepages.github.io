#include <stdlib.h>
#include <stdio.h>
#include <math.h>
int col_del(long n) {
	int i, k = 0;
	for (i = 1; i <= (n / 2); i++)
		if (n % i == 0)
			k++;
	return k;
}
int main() {
	FILE *f1 = fopen("input.txt", "r");
	int n, i = 1;
	long sum = 0;
	fscanf(f1, "%d", &n);
	while (sum <= 2*n) {
		sum+=i;
		i++;
	}
	while (col_del(sum) <= n) {
		sum += i;
		i++;
	}
	sum -= (i-1);
	fclose(f1);
	FILE *f2 = fopen("output.txt", "w");
	fprintf (f2, "%ld\n", sum);
	fclose(f2);
	return 0;
}