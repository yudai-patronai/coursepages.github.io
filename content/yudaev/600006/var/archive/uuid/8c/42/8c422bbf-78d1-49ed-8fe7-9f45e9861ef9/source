#include <stdio.h>
#include <stdlib.h>

int main(int argc, char* argv[], char* envp[]) {
        FILE *file1, *file2;
        void *ptr;
        int len;
        file1 = fopen(argv[1], "r");
        file2 = fopen(argv[2], "w");
        fseek(file1, 0, SEEK_END);
        len = ftell(file1);
        rewind(file1);
        ptr=malloc(len);
        fread(ptr, len, 1, file1);
        fwrite(ptr, len, 1, file2);
        fclose(file1);
        fclose(file2);
        return 0;
}