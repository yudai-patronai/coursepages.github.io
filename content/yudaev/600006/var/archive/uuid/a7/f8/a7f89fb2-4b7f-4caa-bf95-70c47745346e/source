#include <stdio.h>

int number_of_d(long int a)
{
        long int i = 0;
        int res = 0;
        for (i = 1; i * i < a; i++) if (a % i == 0) res += 2;
        if (i * i == a) res++;
        return res;
}

int main(int argc, char *argv[], char* envp[])
{
        FILE *our_input;
        FILE *our_output;
        int n = 0;
        long int res = 0;
        int i = 0;
        our_input = fopen("input.txt", "r");
        fscanf(our_input, "%d", &n);
        fclose(our_input);
        for (i = 0; number_of_d(res) <= n; i++) res += i;
        our_output = fopen("output.txt", "w");
        fprintf(our_output, "%ld", res);
        fclose(our_output);
        return 0;
}