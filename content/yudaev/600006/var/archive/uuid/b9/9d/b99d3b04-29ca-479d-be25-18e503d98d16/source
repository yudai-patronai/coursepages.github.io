#include <stdio.h>
#include <math.h>

int main(int argc, char* argv[], char* envp[])
{
	int i, n, p = 0, res = 0, div = 0, k1 = 0, k2 = 0;
	double ss;
	freopen("output.txt", "wt", stdout);
	freopen("input.txt", "rt", stdin);
	scanf("%d", &n);
	printf("%d ... ", n);
	fclose(stdin);
	int n1, n2;
	while (div <= n)
	{
		k1 = 0;
		k2 = 0;
		p++;
		res += p;
		if (p & 2 == 0)
		{
			n1 = p / 2;
			n2 = p + 1;
		}
		else
		{
			n1 = (p + 1) / 2;
			n2 = p;
		}
		for (i = 1; i <= n1; i++)
		{
			if (res % i == 0)
				k1++;
		}
		for (i = 1; i <= n2; i++)
		{
			if (res % i == 0)
				k2++;
		}
		div = k1 * k2;
	}
	printf("%d", res);
	fclose(stdout);
	return 0;
}