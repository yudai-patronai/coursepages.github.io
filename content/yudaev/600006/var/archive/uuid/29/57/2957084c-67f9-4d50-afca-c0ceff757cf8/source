#include<stdio.h>
#include<stdlib.h>
#include<math.h>

int main()
{
    long long n, i, j, s;
    long long t;
    FILE *file1;
    FILE *file2;
    file1 = fopen("input.txt","rb");
    file2 = fopen("output.txt","wb");
    n = fscanf(file1, "%lld", &n);
    i = 1;
    s = 0;
    while (s <= n)
    {
        t = i*(i+1)/2;
        s = 0;
        for (j = 1; j <= sqrt(t); j++)
        {
            if (t % j == 0)
            {
                s++;
            }
        }
        if (t - sqrt(t)*sqrt(t) == 0)
        {
            s = 2 * s -1;
        }
        else
        {
            s = 2 * s;
        }
        i++;
    }
    fprintf(file2, "%lld", t);
    fclose(file1);
    return 0;
}