#include <stdio.h>
#include <stdlib.h>

int main(int argc, char *argv[])
{
    if (argc < 2)
    {
        printf("Usage: stat filename\n");
        return 1;
    }
    if (freopen(argv[1], "r", stdin) == NULL)
    {
        printf("Can't open file %s\n", argv[1]);
        return 2;
    }
    else
    {
        fseek(stdin, 0, SEEK_END);
        printf("%li", ftell(stdin));
        fclose(stdin);
        return 0;
    }
}