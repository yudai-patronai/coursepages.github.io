#include <stdio.h>

int main(int argc, char* argv[]) {

    freopen("output.txt", "wt", stdout);

    if(argc < 2) {

        printf("Usage: stat filename\n");
        return 1;

    }

    FILE* file = fopen(argv[1], "rt");

    if(file == NULL) {

        printf("Can't open file\n");
        return 2;

    }

    fseek(file, 0, SEEK_END);

    printf("%d\n", ftell(file));

    fclose(stdout);

    return 0;

}
