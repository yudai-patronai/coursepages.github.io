#include <stdio.h>

int main()
{
    int n, i, j;
    FILE*fm = fopen("input.txt", "r");
    FILE*fn = fopen("output.txt", "w+");
    fscanf(fm, "%d", &n);
    //scanf("%d", &n);
    int a, b;
    a = 1;
    b = 1;
    int n1, n2, m1, m2;
    m1, m2, n1, n2 = 0;
    while (a <= n)
    {
        m1 = 0;
        m2 = 0;
        if (b % 2 ==0)
        {
            n1 = b/2;
            n2 = b+1;
        }
        else
        {
            n1 = b;
            n2 = (b+1)/2;
        }
        for (i = 1; i <= sqrt(n1); i++)
        {
            if (n1 % i == 0)
            {
                if (n1/i != i)
                    m1 = m1 + 2;
                else
                    m1++;
            }
        }
        for (j = 1; j <= sqrt(n2); j++)
        {
            if (n2 % j == 0)
            {
                if (n2/j != j)
                    m2 = m2 + 2;
                else
                    m2++;
            }
        }
        a = m1*m2;
        b++;
    }
    b--;
    //printf("%d", b*(b+1)/2);
    fprintf(fn, "%d", b*(b+1)/2);
    close(fn);
    close(fm);
    return 0;
}
