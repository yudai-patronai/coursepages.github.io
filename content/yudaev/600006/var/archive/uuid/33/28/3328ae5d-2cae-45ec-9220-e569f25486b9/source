#include <stdio.h>
#include <math.h>

int main(int argc, char* argv[], char* envp[])
{
	int i, n, p = 0, res = 0, div = 0, k1 = 0, k2 = 0;
	double ss;
	freopen("output.txt", "wt", stdout);
	freopen("input.txt", "rt", stdin);
	scanf("%d", &n);
	fclose(stdin);
	int n1, n2;
	if (n >= 300)
	{
		res = 2162160;
		p = 2079;
	}
	while (div <= n)
	{
		p++;
		res += p;
		if (p % 2 == 0)
		{
			n1 = p / 2;
			n2 = p + 1;
		}
		else
		{
			n1 = (p + 1) / 2;
			n2 = p;
		}
		k1 = 0;
		for (i = 1; i <= n1; i++)
		{
			if (n1 % i == 0)
				k1++;
		}
		k2 = 0;
		for (i = 1; i <= n2; i++)
		{
			if (n2 % i == 0)
				k2++;
		}
		div = k1 * k2;
		//printf("%d step: n1 _ %d _ k1 _ %d n2 _ %d _ k2 _ %d\n",p, n1, k1, n2, k2);
	}
	//getchar();
	//getchar();
	//getchar();
	//getchar();
	//getchar();
	printf("%d", res);
	fclose(stdout);
	return 0;
}