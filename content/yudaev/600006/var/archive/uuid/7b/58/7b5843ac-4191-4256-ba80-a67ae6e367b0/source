#include <stdio.h>

int main(int argc, char* argv[], char* envp[]) {
    int i = 0, j = 0, sum = 0, num = 0, state = 1;
    //printf("%d\n", argc);
    for(i = 1; i < argc; i++) {
        if(argv[i][0] == '-')
            state = 0;
        for(j = state ? 0 : 1; argv[i][j] >= '0' && argv[i][j] <= '9'; j++) {
            num = num*10 + (argv[i][j] - '0');
        }
        sum = state ? sum + num : sum - num;
        num = 0;
        state = 1;
        //printf("%s %s\n", argv[i], envp[i]);
    }
    //printf("%d\n", sum);
    return sum;
}