#include <stdio.h>
#include <stdlib.h>
#include <string.h>

int main(void) {
	int n, m, i, j;
	scanf("%d %d", &n, &m);
	n++;
	m++;
	unsigned int * * p = (unsigned int * *) malloc (n * sizeof(unsigned int *));
	for (i = 0; i < n; i++) {
		p[i] = (unsigned int *) malloc (m * sizeof(unsigned int));
	}
	for (i = 0; i < m; i++) {
		p[0][i] = 1;
	}
	for (i = 0; i < n; i++) {
		p[i][0] = 1;
	}
	for (i = 1; i < n; i++) {
		for (j = 1; j < m; j++) {
			p[i][j] = p[i-1][j] + p[i][j-1];
		}
	}
	printf("%d", p[n-1][m-1]);
	for (i = 0; i < n; i++) {
		free(p[i]);
	}
	free(p);
	return 0;
}
