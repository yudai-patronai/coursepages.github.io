#include <stdio.h>

int main() {
	int n,m,i,k;
	unsigned long int a [21] [21];
	scanf ("%d%d", &n, &m);
	n = n + 1;
	m = m + 1;
	for (i = 2; i < (n + 1); i++) {
		for (k = 2; k < (m + 1); k++) {
			a [i] [k] = 0;
		}
	}
	for (k = 1; k < (m + 1); k++) {
		a [1] [k] = 1;
	}
	for (i = 1; i < (n + 1); i++) {
		a [i] [1] = 1;
	}
	for (i = 2; i < (n + 1); i++) {
		for (k = 2; k < (m + 1); k++) {
			a [i] [k] = a [i] [k - 1] + a [i - 1] [k];
		}
	}
	printf ("%ld", a[n] [m]);
	return 0;
}