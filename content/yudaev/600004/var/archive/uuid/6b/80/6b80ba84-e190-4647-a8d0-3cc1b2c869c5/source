#include <stdio.h>
#include <math.h>

int max2(int x, int y)
{
    if(x > y)
        return x;
    return y;
}

int max3(int x, int y, int z)
{
    int k;
    k = max2(x, y);
    return max2(k, z);
}

int main()
{
    int N;
    scanf("%d", &N);
    unsigned long long int arr[100][100] = {};
    int i, j;
    for(i = 0; i < N; i++)
        for(j = 0; j <= i; j++)
            scanf("%llu", &arr[i - j][j]);
    for(i = 1; i < N; i++)
    {
        arr[0][i] = arr[0][i] + arr[0][i - 1];
    }
    for(i = 1; i < N; i++)
    {
        arr[i][0] = arr[i][0] + arr[i - 1][0];
    }
    for(i = 1; i < N; i++)
    {
        for(j = 1; j < N; j++)
        {
            arr[i][j] = arr[i][j] + max2(arr[i][j - 1],arr[i - 1][j]);
        }
    }
    /*for(i = 0; i < N; i++)
    {
        for(j = 0; j < (N - i); j++)
        {
            printf("%d ", arr[i][j]);
        }
        printf("\n");
    }*/
    int maximum;
    maximum = arr[N - 1][0];
    for(i = 0; i < N; i++)
    {
        if(arr[N - 1 - i][i] > maximum)
        {
            maximum = arr[N - 1 - i][i];
        }
    }
    printf("%d", maximum);
    return 0;
}
