#include <stdlib.h>
#include <stdio.h>

int mas[102][102];

int main() {
	int i = 0, j = 0;
	int x, y;

	scanf("%i", &x);

	for (i = 1; i <= x; i++) {
		for (j = 1; j <= i; j++) {
			scanf("%i", &mas[i][j]);
		}
	}
	for (i = x - 1; i >= 1; i--) {
		for (j = 1; j <= i; j++) {
			if (mas[i + 1][j] >= mas[i + 1][j + 1]) {
				mas[i][j] = mas[i][j] + mas[i + 1][j];
			}
			else {
				mas[i][j] = mas[i][j] + mas[i + 1][j + 1];
			}
		}
	}
	y = mas[1][1];

	printf("%i", y);
	return 0;
}