#include <stdio.h>
#include <stdlib.h>
#include <string.h>

int main(void) {
	int n, i, j;
	scanf("%d", &n);
	n++;
	int * * p = (int * *) malloc (n * sizeof(int *));
	for (i = 0; i < n; i++) {
		p[i] = (int *) malloc (n * sizeof(int));
	}
	for (i = 0; i < n; i++) {
		p[0][i] = 1;
		p[i][0] = 1;
	}
	for (i = 1; i < n; i++) {
		for (j = 1; j < n; j++) {
			p[i][j] = p[i-1][j] + p[i][j-1];
		}
	}
	printf("%d", p[n-1][n-1]);
	for (i = 0; i < n; i++) {
		free(p[i]);
	}
	free(p);
	return 0;
}
