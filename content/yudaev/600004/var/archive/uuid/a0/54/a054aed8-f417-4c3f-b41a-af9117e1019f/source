
#include <stdio.h>

long long int max(long long int a, long long int b, long long int c)
{
	if (a > b)
	{
		if (c > a) return c;
		else return a;
	}
	else
	{
		if (c > b) return c;
		else return b;
	}
}

int main()
{
	long long int A[102][2] = { 0 };
	long long int a = 0;
	int n = 0;
	long long int m = 0;
	int i = 0, j = 0;;
	scanf("%d", &n);
	for (i = 1; i <= n; i++)
	{
		for (j = 1; j <= i; j++)
		{
			scanf("%lld", &a);
			if (i == 2) A[j][1] = a + A[1][0];
			else
			{
				if (j > 1 || j < i - 1) A[j][1] = a + max(A[j - 1][0], A[j][0], A[j + 1][0]);
				if (j == 1) A[j][1] = a + max(A[j][0] - 1, A[j][0], A[j + 1][0]);
				if (j == i - 1) A[j][1] = a + max(A[j - 1][0], A[j][0], A[j][0] - 1);
				if (j == i) A[j][1] = a + A[j - 1][0];
			}
		}
		for (j = 1; j <= i; j++) A[j][0] = A[j][1];
	}
	m = A[1][0];
	for (i = 1; i <= n; i++) if (A[i][0] > m) m = A[i][0];
	printf("%lld", m);
	return 0;
}

