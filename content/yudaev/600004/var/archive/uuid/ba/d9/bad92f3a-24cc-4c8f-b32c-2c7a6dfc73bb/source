#include <stdio.h>
#include <stdlib.h>

int main()
{
    int n;
    scanf ("%d", &n);
    int ** mas = (int **) malloc(n*sizeof(int *));
    for (int i = 0; i < n; i ++)
    {
        mas[i] =(int *) malloc ((i+1)*sizeof(int));
        for (int j = 0; j <= i; j++)
        {
            scanf("%d", mas[i]+j);
        }
    }
    for (int i = n - 2; i >= 0; i --)
    {
        for (int j = 0; j <= i; j++)
        {
            mas[i][j]+= (mas[i+1][j] > mas[i+1][j+1])?mas[i+1][j] : mas[i+1][j+1];
        }
    }
    printf("%d", mas[0][0]);
    return 0;
}
