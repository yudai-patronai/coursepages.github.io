#include <stdio.h>

int main()
{
	int a[101][101];
	int n, i, j;

	scanf("%d", &n);

	for (i = 0; i <= n; i++)
		for (j = 0; j <= n; j++)
			a[i][j] = 0;

	for (i = 0; i <= n; i++)
	{
		a[i][0] = 0;
		a[0][i] = 1;
	}

	for (i = 1; i <= n; i++)
	{
		for (j = 1; j <= n; j++)
		{
			if (j <= i)
				a[i][j] = a[i][j - 1] + a[i - j][j];
			else 
				a[i][j] = a[i][i];
		}
	}
	printf("%d\n", a[n][n]);
	return 0;
}