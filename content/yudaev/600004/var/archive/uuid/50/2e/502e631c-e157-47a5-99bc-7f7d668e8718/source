#include <stdio.h>
#include <stdlib.h>


int main() {
    int n, m;
    int a[25][25];

    scanf("%d %d", &n, &m);

    int i, j;

    for(i = 0; i <= n; i++)
        a[0][i] = 1;

    for(i = 1; i <= m; i++)
        a[i][0] = 1;
    
    for(i = 1; i <= n; i++)
        for(j = 1; j <= m; j++)
            a[j][i] = a[j][i-1] + a[j-1][i];
    
    printf("%d\n", a[n][m]);
    
    return 0;
}