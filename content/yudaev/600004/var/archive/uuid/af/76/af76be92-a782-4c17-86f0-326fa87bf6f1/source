#include <stdio.h>

int main() {
	int i, j, n, m, a[22][22];
	scanf("%d %d", &n, &m);
	for(i = 0; i < 21; i++) {
	a[0][i] = 0;
	a[i][0] = 0;
	}
	for (i = 1; i <= n + 1; i++)
		for (j = 1; j <= m + 1; j++)
			if (i == 1 && j == 1)
				a[i][j] = 1;
			else
				a[i][j] = a[i - 1][j] + a[i][j - 1];
	printf("%d", a[n + 1][m + 1]);
	return 0;
}
