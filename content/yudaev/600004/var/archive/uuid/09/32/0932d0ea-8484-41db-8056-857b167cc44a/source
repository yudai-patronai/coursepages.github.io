#include <stdio.h>

int main(void)
{
    long long a[21][21];
    int i, j, m, n;
    scanf("%d %d", &n, &m);
    for (i = 0; i <= m; i++)
    {
        a[i][0] = 1;
    }
    for (i = 0; i <= n; i++)
    {
        a[0][i] = 1;
    }
    for (j = 1; j <= n; j++)
    {
        for (i = 1; i <= m; i++)
        {
            a[i][j] = a[i-1][j] + a[i][j-1];
        }
    }
    printf("%lld", a[m][n]);
    return 0;
}
