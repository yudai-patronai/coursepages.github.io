#include <stdlib.h>
#include <stdio.h>

double mas[102][102];
double nat(int m, int n);

int main() {
	int x, y;
	int i = 1, j = 1;
	int ii = 1, jj = 1;

	for (i = 1; i <= 21; i++) {
		for (j = 1; j <= 21; j++) {
			mas[i][j] = 0;
		}
	}

	for (ii = 1; ii <= 21; ii++) {
		for (jj = 1; jj <= 21; jj++) {
			mas[ii][jj] = nat(ii, jj);
		}
	}

	scanf("%i %i", &x, &y);

	printf("%.0lf\n", nat(x, y));
	return 0;
}
double nat(int m, int n) {
	if (n == 0 || m == 0) {
		return 1;
	}
	if (n == 1 || m == 1) {
		return m + n;
	}
	if (mas[m][n] != 0) {
		return mas[m][n];
	}
	return (nat(m, n - 1) + nat(m - 1, n));
}