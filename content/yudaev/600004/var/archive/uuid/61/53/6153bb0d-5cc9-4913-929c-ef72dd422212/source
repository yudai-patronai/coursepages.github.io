#include <stdio.h>
#define K 101

int main() {
	int a[K][K];
	int n, i, j, k;
	scanf("%d", &n);
	for (i = 0; i <= n; i++) {
		a[i][1] = 1;
	}
	for (i = 2; i <= n; i++) {
		for (j = 0; j <= n; j++) {
			a[j][i] = 0;
			for (k = j; k >= 0; k -= i) {
				a[j][i] += a[k][i - 1];
			}
		}
	}
	printf("%d\n", a[n][n]);
	return 0;
}
