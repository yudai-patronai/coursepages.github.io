#include <stdio.h>

int a[102][102];

int main() {
    int n;
    long int a[24][24];

    scanf("%d", &n);

    int i, j, t;
    scanf("%d", &a[0][0]);
    a[0][1] = 0;
    for(i = 1; i < n; i++)
    {
        scanf("%d", &t);
        a[i][0] = a[i-1][0] + t;
        for(j = 1; j <= i; j++)
        {
            scanf("%d", &t);
            if(a[i-1][j-1] > a[i-1][j])
                a[i][j] = a[i-1][j-1] + t;
            else
                a[i][j] = a[i-1][j] + t;
        }
        a[i][i+1] = 0;
    }
    
    
    /*for(i = 0; i < n; i++)
    {
        for(j = 0; j < n; j++)
            printf("%d  ", a[i][j]);
        printf("\n");
    }*/
    
    t=0;
    for(i = 0; i < n; i++)
        if(a[n-1][i] > t)
            t = a[n-1][i];
    
    
    printf("%d", t);
    
    return 0;
}