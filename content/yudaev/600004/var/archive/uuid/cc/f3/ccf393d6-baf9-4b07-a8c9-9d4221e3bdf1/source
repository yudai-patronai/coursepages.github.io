
#include <stdio.h>

int max(int i)
{
	int m = 0, j = 0;
	int a;
	for (j = 0; j < i; j++)
	{
		scanf("%d", &a);
		if (m < a) m = a;
	}
	return m;
}

int main()
{
	long long int summ= {0};
	int n = 0;
	int i = 0;
	scanf("%d", &n);
	for (i = 1; i <= n; i++)
	{
		summ = summ + max(i);
	}
	printf("%lld", summ);
	return 0;
}

