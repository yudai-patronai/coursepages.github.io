#include <stdio.h>

int main() {

    int total;
    int time[5000][4];
    int dp[5000];
    int i,j;

    scanf("%d", &total);
    for(i = 0; i < total; ++i)
        for(j = 1; j <= 3; ++j)
            scanf("%d", &time[i][j]);

    dp[0] = time[0][1];
    dp[1] = time[0][1] + time[1][1];
    if(dp[1] > time[0][2])
        dp[1] = time[0][2];
    dp[2] = dp[1] + time[2][1];
    if(dp[2] > dp[0] + time[1][2])
        dp[2] = dp[0] + time[1][2];
    if(dp[2] > time[0][3])
        dp[2] = time[0][3];
    for(i = 3; i < total; ++i) {

        dp[i] = dp[i-1] + time[i][1];
        if(dp[i] > dp[i-2] + time[i-1][2])
            dp[i] = dp[i-2] + time[i-1][2];
        if(dp[i] > dp[i-3] + time[i-2][3])
            dp[i] = dp[i-3] + time[i-2][3];

    }

    printf("%d\n", dp[total-1]);

    return 0;

}
