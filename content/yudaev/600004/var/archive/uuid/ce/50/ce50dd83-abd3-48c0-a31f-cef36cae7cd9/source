#include <stdio.h>

int main()
{
	int tri[102][102];
	int n, i, j;
	for (i = 0; i < 101; i++)
		for (j = 0; j < 101; j++)
			tri[i][j] = 0;
	scanf("%d", &n);
	for (i = 1; i <= n; i++)
		for (j = 1; j <= i; j++)
			scanf("%d", &tri[i][j]);
	for (i = 2; i <= n; i++)
		for (j = 1; j <= i; j++)
		{
			if (tri[i - 1][j - 1] > tri[i - 1][j])
				tri[i][j] += tri[i - 1][j - 1];
			else
				tri[i][j] += tri[i - 1][j];			
		}
	int max = -1;
	for (i = 1; i <= n; i++)
	{
		if (tri[n][i] > max)
			max = tri[n][i];
	}
	printf("%d\n", max);
    return 0;
}

