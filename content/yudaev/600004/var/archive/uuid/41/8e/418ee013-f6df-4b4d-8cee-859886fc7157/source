#define _CRT_SECURE_NO_WARNINGS
#include <stdio.h>
#include <stdlib.h>
unsigned long long ways(int n, int m)
{
	unsigned long long *p, o;
	int i, j;
	p = (unsigned long long*)malloc((m + 1)*(n + 1)*sizeof(unsigned long long));
	for (j = 0; j < m + 1; j++)
	{
		p[j] = 1;
	}
	for ( i = 0; i < n+1; i++)
	{
		p[i*(m + 1)] = 1;
	}
	for (i = 1; i < n + 1; i++)
	{
		for (j = 1; j < m + 1; j++)
		{
			p[i*(m + 1) + j] = p[i*(m + 1) + j - 1] + p[(i - 1)*(m + 1) + j];
		}
	}
	o = p[n*m+n+m];
	free(p);
	return o;
}
int main()
{
	int n, m;
	scanf("%d%d", &n, &m);
	printf("%llu", ways(n, m));
	return 0;
}