#include <stdio.h>
#include <stdlib.h>
#include <string.h>

int main(void) {
	int n, i, j;
	scanf("%d", &n);
	n++;
	int * * p = (int * *) malloc (n * sizeof(int *));
	for (i = 0; i < n; i++) {
		p[i] = (int *) malloc (n * sizeof(int));
	}
	p[0][0] = 1;
	p[1][0] = 0;
	for (i = 0; i < n; i++) {
		for (j = 0; j < n; j++) {
			if (j <= i)
				p[i][j] = p[i][j-1] + p[i-j][j];
			else
				p[i][j] = p[i][i];
		}
	}
	printf("%d", p[n-1][n-1]);
	return 0;
	for (i = 0; i < n; i++)
		free(p[i]);
	free(p);
}