#include <stdio.h>
#include <stdlib.h>

int main()
{
    int A[30][30], n = 0, m = 0, i = 0, j = 0;
    scanf("%i %i", &n, &m);
    if((n == 0) || (m == 0))
        printf("0");
    else
    {
        if((n == 1) && (m == 1))
            printf("2");
        else
        {
            for(i = 0; i <= n; i++)
                for (j = 0; j <=m; j++)
                    A[i][j] = 0;
            A[0][0] = 1;
            for (i = 0; i <= n; i++)
                for(j = 0; j <= m; j++)
                    {   if(i > 0)
                            A[i][j] += A[i - 1][j];
                        if(j > 0)
                            A[i][j] +=A[i][j - 1];
                    }
            printf("%i", A[n][m]);
        }
    }
    return 0;


}
