#include <stdlib.h>
#include <stdio.h>

int mas[102][102];
int nat(int m, int n);
int main() {
	int x;
	for (int i = 1; i <= 100; i++) {
		for (int j = 1; j <= 100; j++) {
			mas[i][j] = 0;
		}
	}

	for (int i = 1; i <= 50; i++) {
		for (int j = 1; j <= 50; j++) {
			mas[i][j] = nat(i, j);
		}
	}
	for (int i = 51; i <= 100; i++) {
		for (int j = 51; j <= 100; j++) {
			mas[i][j] = nat(i, j);
		}
	}

	scanf("%i", &x);
	
	printf("%i", nat(x, x));
	
	return 0;
}
int nat(int m, int n) {
	if (n == 0) {
		if (m == 0) return 1;
		else return 0;
	}
	if (mas[m][n] != 0) {
		return mas[m][n];
	}
	int d = 0;
	if (n <= m) {
		d = nat(m, n - 1) + nat(m - n, n);
	}
	else d = nat(m, m);
	return d;
}