#include <stdio.h>

int min(int a, int b, int c)
{
	if ((a <= b) && (a <= c))
		return a;
	if ((b <= a) && (b <= c))
		return b;
	return c;
}

int main()
{
	int q[5003][4], n, i, j;
	for (i = 1; i <= 5000; i++)
		for (j = 0; j < 3; j++)
			q[i][j] = 3601;
	scanf("%d", &n);
	for (i = 1; i <= n; i++)
		for (j = 0; j < 3; j++)
			scanf("%d", &q[i][j]);
	q[1][3] = q[1][0];
	if (n > 1)
		q[2][3] = min(4000, q[1][1], q[1][0] + q[2][0]);
	if (n > 2)
		q[3][3] = min(q[1][2], q[3][0] + q[2][3], q[1][3] + q[2][1]);
	for (i = 4; i <= n; i++)
		q[i][3] = min(q[i - 3][3] + q[i - 2][2], q[i - 2][3] + q[i - 1][1], q[i - 1][3] + q[i][0]);
	printf("%d\n", q[n][3]);                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 
    return 0;
}

