#include <stdio.h>
#include <stdlib.h>
#define MAX 21

int main() {
    int n, m, i, j;
    int N[MAX][MAX];
    scanf("%d%d", &n, &m);
    for(i = 0; i < n + 1; i ++) {
        N[i][0] = 1;
    }
    for(i = 0; i < m + 1; i ++) {
        N[0][i] = 1;
    }
    for(i = 1; i < n + 1; i++) {
        for(j = 1; j < m + 1; j++) {
            N[i][j] = N[i-1][j] + N[i][j-1];
        }
    }
    printf("%d", N[n][m]);
    return 0;
}