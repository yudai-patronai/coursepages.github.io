#include <stdio.h>
#define SIZE 150

int main() {

    long long dp[SIZE][SIZE];
    int num = 0;
    int i = 0;
    int j = 0;
    int k = 0;
    for(i = 0; i < SIZE; ++i)
        for(j = 0; j < SIZE; ++j)
            dp[i][j] = 0;

    scanf("%d", &num);

    for(i = 0; i <= num; ++i)
        dp[0][i] = 1;

    for(i = 1; i <= num; ++i) {
        for(j = 0; j <= i; ++j)
            for(k = 1; k <= j; ++k)
                dp[i][j] += dp[i-k][k];
        for(j = i+1; j <= num; ++j)
            dp[i][j] = dp[i][i];
    }

    printf("%lld\n", dp[num][num]);

    return 0;

}
