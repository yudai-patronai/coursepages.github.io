#include <stdio.h>
#define min(a, b) (a) < (b) ? (a) : (b)

int main()
{
	int n, i, j, k;
	unsigned long int q, a[100][100];
	scanf("%d", &n);
	for(i = 1; i <= n; i++)
		for(j = 1; j<=i; j++)
			if(j == i) 
				a[i][j] = 1; else
				{
					a[i][j] = 0;
					q = min(j, i-j);
					for(k = 1; k <= q; k++)
						a[i][j] += a[i-j][k];
				}
	q = 0;
	for(i = 1; i <= n; i++)
		q += a[n][i];
	printf("%ld", q);	
return 0;
}
