#include <stdio.h>
#include <stdlib.h>
unsigned long long int part(int n, int k)
{
	int m, i; 
	unsigned long long int ans, *p;
	p = (unsigned long long int*)malloc((n+1)*(k+1)*sizeof(unsigned long long int));
	for (i = 1; i < n + 1; i++)
	{
		p[i*(k + 1)] = 0;
	}
	for (i = 0; i < k + 1; i++)
	{
		p[i] = 1;
	}
	for (i = 1; i < n + 1; i++)
	{
		for (m = 1; m < i + 1; m++)
		{
			p[i*(k + 1) + m] = p[i*(k + 1) + m - 1] + p[(i - m)*(k + 1) + m];
		}
		for (m = i + 1; m < k + 1; m++)
		{
			p[i*(k + 1) + m] = p[i*(k + 1) + i];
		}
	}
	ans = p[n*k+n+k];
	free(p);
	return ans;
}
int main()
{
	int n;
	scanf("%d", &n);
	printf("%llu", part(n, n));
	return 0;
}