#include <stdio.h>

#define max(a,b) (a) > (b) ? (a) : (b)
int main()
{
	int mas[101][102], i, j, n;
	scanf("%d", &n);
	for(i = 0; i <= n; i++)
		for ( j = 0; j <= i+1; j++)
			mas[i][j]=0;
	for(i = 1; i <= n; i++)
		for ( j = 1; j <= i; j++)
			scanf("%d", &mas[i][j]);
	for(i = 1; i <= n; i++)
	{
		for ( j = 1; j <= i; j++)
		{
			mas[i][j]+=max(mas[i-1][j-1], mas[i-1][j]);
	//		printf("%d ", mas[i][j]);
		}
	//	printf("\n");
	}
	j=0;
	for(i = 1; i <= n; i++)
		j=max(j, mas[n][i]);
	printf("%d", j);
	return 0;
}



