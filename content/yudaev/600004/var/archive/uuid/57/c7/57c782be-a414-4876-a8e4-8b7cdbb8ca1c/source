#include <stdlib.h>
#include <stdio.h>

int main() {
	int i = 1, j = 1;
	int x = 0;
	double mas[102][102];

	scanf("%i", &x);

	for (i = 1; i <= x; i++) {
		for (j = 1; j <= i; j++) {
			scanf("%lg", &mas[i][j]);
		}
	}
	for (i = x - 1; i >= 1; i--) {
		for (j = 1; j <= i; j++) {
			if ((mas[i + 1][j]) >= (mas[i + 1][j + 1])) {
				mas[i][j] = (mas[i][j] + mas[i + 1][j]);
			}
			else {
				mas[i][j] = (mas[i][j] + mas[i + 1][j + 1]);
			}
		}
	}

	printf("%lg", mas[1][1]);
	return 0;
}