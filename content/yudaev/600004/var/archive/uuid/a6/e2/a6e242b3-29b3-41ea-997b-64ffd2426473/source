#include <stdio.h>

int main(void) {
	int n,i;
	int a [5001] [3];
	int d [5001];
	scanf ("%d\n", &n);
	for (i = 1; i < n+1; i++) {
		scanf ("%d%d%d", &a [i] [1],&a [i] [2],&a [i] [3]);
	}
	d[0] = 0;
	d[1] = a[1] [1];
	if ((a[1] [1] + a [2] [1]) > a [1][2]) {
		d [2] = a [1][2];
	}
	if ((a[1] [1] + a [2] [1]) <= a [1][2]) {
		d [2] = (a[1] [1] + a [2] [1]);
	}
	
	for (i = 3; i < n + 1; i++ ){
		if (((a[i] [1] + d [i-1]) < (a [i-1][2] + d[i-2])) && ((a[i] [1] + d [i-1]) < (a [i-2] [3] + d [i-3]))) {
			d [i] = (a[i] [1] + d [i-1]);
		}	
		if (((a [i-1][2] + d[i-2]) < (a[i] [1] + d [i-1])) && ((a [i-1][2] + d[i-2]) < (a [i-2] [3] + d [i-3]))) {
			d [i] = (a [i-1][2] + d[i-2]);
		}
		if (((a [i-2] [3] + d [i-3]) < a [i-1][2] + d[i-2]) && ((a [i-2] [3] + d [i-3]) < (a[i] [1] + d [i-1]))) {
			d [i] = (a [i-2] [3] + d [i-3]);
		}			
	}
	
	printf ("%d",d[n]);
	
	
	return 0;
}
