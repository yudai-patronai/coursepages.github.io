#define _CRT_SECURE_NO_WARNINGS
#include <stdio.h>
#define M 5000
#define N 6000

int min(int x, int y, int z)
{
	if (x <= y && x <= z)
		return x;
	
	if (y <= x && y <= z)
		return y;
	return z;
	

}

int main() 
{
	int A[5000], B[5000], C[5000], T[5000], n, i;
	scanf("%d", &n);
	for (i = 1; i <= n; i++){
		scanf("%d%d%d", &A[i], &B[i], &C[i]);
	}
	T[1] = A[1];
	if (n >= 2){
		T[2] = min(T[1] + A[2], B[1], M);
		if (n >= 3){
			T[3] = min(T[2] + A[3], T[1] + B[2], C[1]);
			for (i = 4; i <= n; i++){
				T[i] = min(T[i - 1] + A[i], T[i - 2] + B[i - 1], T[i - 3] + C[i - 2]);
			}
		}
	}

	printf("%d", T[n]);
	return 0;
}
