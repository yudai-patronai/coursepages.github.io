#include <stdio.h>
#include <stdlib.h>
#include <string.h>

long long max(long long a, long long b)
{
    if (a > b)
        return a;
    return b;
}

int main()
{
    int N;
    long long F[100][100];
    scanf("%i", &N);
    int i;
    int j;
    for (i = 0; i < N; i++)
        for (j = 0; j <= i; j++)
            scanf("%lli", &F[i][j]);
    for (i = N - 2; i >= 0; i--)
        for (j = 0; j <= i; j++)
            F[i][j] = F[i][j] + max(F[i+1][j], F[i+1][j+1]);
    printf("%lli", F[0][0]);
    return 0;
}
