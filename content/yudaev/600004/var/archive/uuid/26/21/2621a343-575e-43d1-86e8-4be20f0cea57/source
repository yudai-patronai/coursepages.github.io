#include <stdio.h> 
#define _CRT_SECURE_NO_WARNINGS 
int k=0,l,d[200000000],p=1,res=0;
void varp(int n){
	int i,j;
	k++;
	for(i=d[k];i<=n;i++){
		if(p==0 && d[k]<d[k-1]){
			for(j=1;j<=k-1;j++){
				p=1;
			}
		}
		if(k==1 || p==1){
		p=1;
		}
		else{
			if(p==1)
	                res++;
			d[k]=1;
			k--;
			p=0;
			return;
		}
		d[k]=i;
		if(n-i>0 && (d[k-1]>=d[k] || d[k-1]==0)){
			varp(n-i);
		}
		else{
			d[k]=1;
                        res++;
			k--;
			p=0;
			return;
		}
	}
	k--;
	return;
}
int main(){
	int n,i;
	scanf("%i",&n);
	l=n;
	for(i=0;i<=n;i++){
		d[i]=1;
	}
	d[0]=0;
	varp(n);
        printf("%i",res);
	return 0;
}