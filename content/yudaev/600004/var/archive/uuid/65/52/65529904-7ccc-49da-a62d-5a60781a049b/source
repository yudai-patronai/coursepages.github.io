#include <stdio.h>

int main()
{
    long long int a[21][21];
    int i, j, N, M;

    scanf("%d %d", &N, &M);

  //заполняем левые и верхние крайние элементы сетки единицами
    for (i = 0; i <= N; ++i)
        a[i][0] = 1;
    for (i = 0; i <= M; ++i)
        a[0][i] = 1;

    //значение каждой, кроме рассмотренных, ячейки равно сумме двух предыдущих
    for (i = 1; i <= N; ++i)
        for (j = 1; j <= M; ++j)
        {
            a[i][j] = a[i-1][j] + a[i][j-1];
        }

    printf("%lld", a[N][M]);

    return 0;
}
