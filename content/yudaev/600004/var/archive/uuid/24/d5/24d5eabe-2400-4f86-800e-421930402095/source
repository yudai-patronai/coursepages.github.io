#include <stdio.h>
#include <math.h>

int min2(int x, int y)
{
    if(x > y)
        return y;
    else if(x <= y)
        return x;
}

int min3(int x, int y, int z)
{
    int k;
    k = min2(x, y);
    return min2(k, z);
}

