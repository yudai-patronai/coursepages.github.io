#include <stdio.h>
#include <stdlib.h>

int max(int x1, int x2)
{
    if(x1 > x2)
        return x1;
    else
        return x2;
}
int main()
{
    long int A[120][120] = {0}, B[120] = {0}, N = 0, d = 0, i = 0, j = 0, t = 0;
    scanf("%li", &N);
    scanf("%li", &A[0][0]);
    for(i = 1; i < N; i++)
    {
        for(j = 0; j <= i; j++)
                scanf("%li", &B[j]);
        A[i][0] = A[i - 1][0] + B[0];
        A[i][i] = A[i - 1][i - 1] + B[i];
        for(t = 1; t <= i; t++)
            A[i][t] = max(A[i-1][t-1],A[i-1][t]) + B[t];
    }
    for(t = 0; t < i; t++)
    {
        if(A[i-1][t] > d)
            d = A[i-1][t];
    }
    printf("%li", d);
    return 0;
}

