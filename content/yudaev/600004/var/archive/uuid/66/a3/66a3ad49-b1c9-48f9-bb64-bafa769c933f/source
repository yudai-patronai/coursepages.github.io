#include <stdio.h>


int a[102][102];

int main() {
    int n;

    scanf("%d", &n);

    int i, j;
    a[0][0] = 1;
    
    for(i = 1; i <= n; i++)
        a[0][i] = 0;
    
    for(j = 1; j <= n; j++)
    {
        for(i = 0; i <= n; i++)
        {
            if(j > i)
                a[j][i] = a[i][i];
            else
                a[j][i] = a[j-1][i] + a[j][i-j];
        }
    }
    
    
    /*for(i = 0; i <= n; i++)
    {
        for(j = 0; j <= n; j++)
            printf("%d  ", a[i][j]);
        printf("\n");
    }*/
    
    
    printf("%d", a[n][n]);
    
    return 0;
}