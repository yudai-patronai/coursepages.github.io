#include <stdlib.h>
#include <stdio.h>
#include <malloc.h>
int main(){
    int n, i, ans = 0;
    scanf("%d", &n);
    int *a, *b, *c;
    a = malloc (n * sizeof(int));
    b = malloc (n * sizeof(int));
    c = malloc (n * sizeof(int));
    for (i = 0; i < n; i++)
        scanf("%d %d %d", &a[i], &b[i], &c[i]);
    for (i = n - 1; i >= 0;) {
        if (i - 2 >= 0 && (c[i-2] < a[i-2] + a[i-1] + a[i] || c[i-2] < b[i-2] + a[i] || c[i-2] < a[i-2] + b[i-1])) {
            ans +=c[i-2];
            i-=3;
        }
        else if (i - 1 >= 0 && b[i-1] < a[i-1] + a[i]) {
            ans += b[i-1];
            i-=2;
        }
        else {
            ans += a[i];
            i--;
        }
    }
    free(a);
    free(b);
    free(c);
    printf("%d\n", ans);
    return 0;
}