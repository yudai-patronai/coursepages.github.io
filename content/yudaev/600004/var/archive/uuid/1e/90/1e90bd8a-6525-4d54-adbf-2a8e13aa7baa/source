#include <stdio.h>
#include <stdlib.h>
#include <string.h>

int mini (int a, int b)
{
    if (a < b)
        return a;
    return b;
}

int min(int a, int b, int c)
{
    return (mini(mini(a, b), c));
}

int main()
{
    int N = 1;
    int A;
    int B, B1;
    int C, C1, C2;
    int T, T1 = 0, T2, T3;
    scanf("%i", &N);
    int i;
    for (i = 0; i < N; i++)
    {
        scanf("%i %i %i", &A, &B, &C);
        if (i == 0)
            T = A;
        if (i == 1)
            T = mini(T1 + A, B1);
        if (i == 2)
            T = min(T1 + A, T2 + B1, C2);
        if (i > 2)
            T = min(T1 + A, T2 + B1, T3 + C2);
        C2 = C1;
        C1 = C;
        T3 = T2;
        T2 = T1;
        T1 = T;
        B1 = B;
    }
    printf("%i\n", T1);
    return 0;
}