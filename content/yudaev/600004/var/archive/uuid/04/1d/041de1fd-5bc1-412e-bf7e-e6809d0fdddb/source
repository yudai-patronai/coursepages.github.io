#include <stdio.h>



int main()
{
	int n, m;
	scanf("%d%d", &n, &m);
	int a[22][22];
	int i, j;
	for (i = 0; i <= n; i++)
		a[i][0] = 1;
	for (j = 0; j <= m; j++)
		a[0][j] = 1;
	for (i = 1; i <= n; i++)
		for (j = 1; j <= m; j++)
			a[i][j] = a[i - 1][j] + a[i][j - 1];
	printf("%d", a[n][m]);
	return 0;
}