#include <stdio.h>

int main()
{
	unsigned long long int a[21][21];
	int i, j, n, m;
	scanf("%d %d", &n, &m);
	for(i = 0; i < n+1; i++)
		a[i][0] = 1;
	for(i = 0; i < m+1; i++)
		a[0][i] = 1;
	for(i = 1; i < n+1; i++)
		for(j = 1; j < m+1; j++)
			a[i][j] = a[i][j-1] + a[i-1][j];
	printf("%ld", a[n][m]);		
return 0;
}
