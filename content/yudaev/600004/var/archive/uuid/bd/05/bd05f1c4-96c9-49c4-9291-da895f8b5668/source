#include <stdio.h>


int main()
{
    long long  int   A[23][23] ;
    int n , m , i , u  ;
    scanf( "%d %d" , & n , & m );
    for (i = 0 ; i < 23 ; i++)
    {
         A[0][i] = 1 ;
         A[i][0] = 1 ;

    }
    for (u = 1 ; u < 23 ; u++)
    {
        for (i = 1 ; i < 23 ; i++)
            A[i][u] = 0;
    }

    for (i = 1 ; i < 23 ; i++)
    {

        for (u = 1 ; u < 23 ; u++)
        {

            A[i][u] = A[i][u-1] + A[i - 1][u];

        }

    }




    printf("%ld" , A[m][n]);


    return 0;
}
