#include <stdio.h>
#include <stdlib.h>
int main() {
	int n, m, i, j;
	scanf("%d %d", &n, &m);
	if ((n == 1) && (m == 1)) {
		printf("2\n");
		return 0;
	}
	int *c = (int*) calloc(((n+1)*(m+1)), sizeof(int));
	for (i = 0; i < m+1; i++)
		c[i] = 1;
	for (i = 0; i < n+1; i++)
		c[i*(m+1)] = 1;
	for (i = 1; i < n+1; i++)
		for (j = 1; j < m+1; j++)
			c[i*(m+1) + j] = c[(i-1)*(m+1) + j] + c[i*(m+1) + j-1];
	printf("%d\n", c[(n+1)*(m+1)-1]);
	free(c);
	return 0;
}