#include <stdio.h>
#include <stdlib.h>
#include <string.h>

int main(void) {
	int n, i, j;
	scanf("%d", &n);
	n++;
	int * * p = (int * *) malloc (n * sizeof(int *));
	for (i = 0; i < n; i++) {
		p[i] = (int *) malloc (n * sizeof(int));
	}
	for (i = 0; i < n; i++) {
		for (j = 0; j < n; j++) {
			if (j != 0) {
				if (j <= i)
					p[i][j] = p[i][j-1] + p[i-j][j];
				else
					p[i][j] = p[i][i];
			}
			else {
				if (i == 0)
					p[i][j] = 1;
				else
					p[i][j] = 0;
			}
		}
	}
	printf("%d", p[n-1][n-1]);
	for (i = 0; i < n; i++)
		free(p[i]);
	free(p);
	return 0;
}