#include <stdio.h>

int min(int a, int b, int c)
{
	if ((a <= b) && (a <= c))
		return a;
	if ((b <= a) && (b <= c))
		return b;
	return c;
}

int main()
{
	int q[5003][3], n, i, j, sum = 0;
	for (i = 1; i <= 5000; i++)
		for (j = 0; j < 3; j++)
			q[i][j] = 3601;
	scanf("%d", &n);
	for (i = 1; i <= n; i++)
		for (j = 0; j < 3; j++)
			scanf("%d", &q[i][j]);
	for (i = 1; i <= n; i++)
	{
		
		if (q[i][2] <= min(q[i][1] + q[i + 2][0], q[i][0] + q[i + 1][1], q[i][0] + q[i + 1][0] + q[i + 2][0]))
		{
			sum += q[i][2];
			i += 2;
		}
		else
		{
			if (q[i][1] + q[i + 2][0] == min(q[i][1] + q[i + 2][0], q[i][0] + q[i + 1][1], q[i][0] + q[i + 1][0] + q[i + 2][0]))
			{
				sum += q[i][1];
				i++;
			}
			else
				sum += q[i][0];
		}
	}
	printf("%d\n", sum);                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 
    return 0;
}

