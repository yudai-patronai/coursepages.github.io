#include <stdlib.h>
#include <stdio.h>

int mas[102][102];
int nat(int m, int n);
int main() {
	int x;
	for (int i = 1; i <= 90; i++) {
		for (int j = 1; j <= 90; j++) {
			mas[i][j] = 0;
		}
	}

	for (int ii = 1; ii <= 90; ii++) {
		for (int jj = 1; jj <= 90; jj++) {
			mas[ii][jj] = nat(ii, jj);
		}
	}

	scanf("%i", &x);
	
	printf("%i", nat(x, x));

	return 0;
}
int nat(int m, int n) {
	if (n == 0) {
		if (m == 0) return 1;
		else return 0;
	}
	if (mas[m][n] != 0) {
		return mas[m][n];
	}
	int d = 0;
	if (n <= m) {
		d = nat(m, n - 1) + nat(m - n, n);
	}
	else d = nat(m, m);
	return d;
}