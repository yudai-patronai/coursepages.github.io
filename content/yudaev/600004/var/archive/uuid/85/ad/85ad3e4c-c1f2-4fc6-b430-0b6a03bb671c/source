#include <stdio.h>
#define K 101

int max(int a, int b) {
	if (a > b) {
		return a;
	} else {
		return b;
	}
}

int main() {
	int a[K][K];
	int n, i, j, ans = 0;
	scanf("%d", &n);
	for (i = 1; i <= n; i++) {
		for (j = 1; j <= i; j++) {
			scanf("%d", &a[i][j]);
			a[i][j] += max(a[i-1][j], a[i-1][j-1]);
		}
	}
	for (j = 1; j <= n; j++) {
		ans = max(ans, a[n][j]);
	}
	printf("%d", ans);
	return 0;
}
