#include <stdio.h>
int main()
{
    int n = 0, m = 0;
    // int c = 0, b = 0;
    int i = 0, j = 0, max = 0;
    long long int sum  = 0;
    long long int  a[100][100] = {};
    scanf ( "%d", &n);
    //a[0][0] = 1;
    //printf ( "%d\n", a[0][0] );
    m = 1;
    for ( i = 0; i < n; i++ )
    {
        for ( j = 0; j < m; j++ )
        {   
            scanf ( "%lli", &(a[i][j]) );
            
        }
        max = a[i][0];
        for ( j = 0; j < m; j++ )
        {   
            if ( a[i][j] > max )
            {
                max  = a[i][j];
            }
            
        }
    sum += max;
        
    m++;
       
    }
    
    printf ( "%lli", sum);
    return 0;
}