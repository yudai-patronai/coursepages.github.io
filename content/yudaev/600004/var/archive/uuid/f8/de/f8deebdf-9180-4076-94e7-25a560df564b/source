#include <stdio.h>
int main()
{
    int N = 0, M = 0;
    scanf("%d%d", &N, &M);
    int ways[21][21];
    ways[0][0] = 1;
    int i = 0; j = 0;
    for(i = 0; i <= N; ++i)
    {
        for(j = 0; j <= M; ++j)
        {
            if(i == 0 || j == 0)
                ways[i][j] = 1;
            else
                ways[i][j] = ways[i - 1][j] + ways[i][j - 1];
        }
    }
    printf("%d", &ways[N][M])
    return 0;
}
