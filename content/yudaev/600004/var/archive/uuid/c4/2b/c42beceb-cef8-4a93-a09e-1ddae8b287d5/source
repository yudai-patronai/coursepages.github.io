#include <stdio.h>
#include <stdlib.h>


int main() {
    int n;
    int a[5004];
    
    scanf("%d", &n);
    
    a[0] = 3601;
    a[1] = 3601;
    
    int i;
    int x, y, z, t = 0;
    for(i = 0; i < n; i++)
    {
        a[i+2] = 3601;
        scanf("%d %d %d", &x, &y, &z);
        
        if(x + t < a[i])
            a[i] = x + t;
        
        if(y + t < a[i+1])
            a[i+1] = y + t;
        
        if(z + t < a[i+2])
            a[i+2] = z + t;
        
        t = a[i];
    }
    
    printf("%d", t);
    
    return 0;
}