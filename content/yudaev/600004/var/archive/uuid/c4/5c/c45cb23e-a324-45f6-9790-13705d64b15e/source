#include <stdio.h>
int main()
{
    int n = 0, m = 0;
    // int c = 0, b = 0;
    int i = 0, j = 0;
    int sum  = 0;
    int  a[32][32] = {};
    scanf ( "%d %d", &n, &m );
    a[0][0] = 1;
    //printf ( "%d\n", a[0][0] );
    
    for ( i = 0; i < n + 3; i++ )
    {
        for ( j = 0; j < m + 3; j++ )
        {   
            a[i][j + 1] += a[i][j];
            a[i + 1][j] += a[i][j];
        }
       
    }
    printf ( "%d", a[n][m] );
    return 0;
}