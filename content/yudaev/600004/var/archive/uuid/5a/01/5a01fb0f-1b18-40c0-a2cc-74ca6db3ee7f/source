#include <stdio.h>
#include <stdlib.h>
#include <string.h>

int main()
{
    int N;
    int M;
    scanf("%i %i", &N, &M);
    int i;
    int j;
    int F[22][22];
    for (i = 0; i <= N; i++)
        F[i][0] = 1;
    for (i = 0; i <= M; i++)
        F[0][i] = 1;
    for (i = 1; i <= N; i++)
        for (j = 1; j <= M; j++)
            F[i][j] = F[i][j-1] + F[i-1][j];
    printf("%i\n", F[N][M]);
    return 0;
}