##include <stdio.h>
#include <stdlib.h>
int msin(int a, int b, int c)
{
	if (a <= b && a <= c)
		return a;
	if (b <= a && b <= c)
		return b;
	else return c;
}
int main()
{
	int a[5001], b[5001], c[5001], d[5001], i, n;
	scanf("%d", &n);
	for (i = 0; i < n; i++)
		scanf("%d%d%d", &a[i], &b[i], &c[i]);
	d[0] = a[0];
	if (n >= 1)
	{
		d[1] = msin(d[0] + a[1], b[0], b[0]);
		if (n >= 2)
		{
			d[2] = msin(d[1] + a[2], d[0] + b[2], c[3]);
			for (i = 3; i < n; i++)
			{
				d[i] = msin(d[i - 1] + a[i], d[i - 2] + b[i - 1], d[i - 3] + c[i - 2]);
			}
		}
	}
	printf("%d", d[n - 1]);
	return 0;
}