#include <stdio.h>
#include <stdlib.h>

int main()
{
    int n, m;
    int i, j;
    scanf ("%d %d", &n, &m);

    unsigned long long mas [40][40]; //mas[N][K]
    for (i = 0; i < n + m; i++)
        {
            for (j = 0; j < (n < m ? n : m); j++)
                {
                    if (j == 0) mas [i][j] = i + 1;
                    else
                        {
                            if (i == j) mas[i][j] = 1;
                            if (j > i)
                                {
                                    mas [i][j] = 0;
                                    break;
                                }
                            if (j < i) mas[i][j] = mas[i-1][j-1] + mas[i - 1][j];
                        }
                }
        }
    printf ("%llu", mas[n+m-1][(n < m ? n : m)-1]);
    // int n, m;
    return 0;
}

