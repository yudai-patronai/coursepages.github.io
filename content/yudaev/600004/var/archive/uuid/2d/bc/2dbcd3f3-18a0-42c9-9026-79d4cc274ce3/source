#include <stdio.h>
#include <stdlib.h>

int tr[128][128];

int main()
{
    int i, j, N;
    int max = 0;
    scanf("%d", &N);
    for(i = 0; i < 128; i = i + 1)
        for(j = 0; j < 128; j = j + 1)
            tr[i][j] = 0;
    for(i = 0; i < N; i = i + 1)
        for(j = 0; j < i+1; j = j + 1)
            scanf("%d", &tr[i][j]);
    for(i = 1; i < N; i++)
        tr[i][0] += tr[i-1][0];
    for(i = 0; i < N; i++)
        for(j = 1; j < i+1; j = j + 1) {
            if (tr[i-1][j-1] > tr[i-1][j]) {     
                tr[i][j] += tr[i-1][j-1];
            } else {
                tr[i][j] += tr[i-1][j];
            }
        }
    for(j = 0; j < N; j = j + 1)
        if(tr[N-1][j] > max)
            max = tr[N-1][j];
    printf("%d", max);
    return 0;
}