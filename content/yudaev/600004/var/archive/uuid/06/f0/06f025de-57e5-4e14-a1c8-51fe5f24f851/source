#include <stdlib.h>
#include <stdio.h>

int MAX(int a, int b)
{
	return a > b ? a : b;
}

int main()
{
	int N = 0, i, j, now;
	scanf("%i", &N);
	int arr[100];
	for (i = 0; i < N; i++)
	{
		for (j = N - 1 - i; j < N; j++)
		{
			scanf("%i", &now);
			if (j != N-1)
			{
				arr[j] = MAX(arr[j] + now, arr[j + 1] + now);
			}
			else if (j == N - 1)
			{
				arr[j] += now;
			}
		}
	}
	int maxS = 0;
	for (i = 0; i < N; i++)
	{
		printf("%i ", arr[i]);
		maxS = MAX(maxS, arr[i]);
	}
	printf("\n%i", maxS);
	return 0;
}
