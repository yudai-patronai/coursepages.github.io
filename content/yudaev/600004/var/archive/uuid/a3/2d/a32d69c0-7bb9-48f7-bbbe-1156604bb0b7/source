#include <stdio.h>
int maxi (int _a, int _b)
{
    if (_a > _b)
    {
        return _a;
    }
    else
    {
        return _b;
    }
}
int main(void)
{
    int s, n, i, j;
    int a[100][100];
    scanf("%d", &n);
    for (i = 0; i < n; i++)
    {
        for (j = 0; j <= i; j++)
        {
            scanf("%d", &a[i][j]);
        }
    }
    for (i = n - 1; i > 0; i--)
    {
        for (j = 0; j < i; j++)
        {
            a[i][j] = maxi(a[i][j], a[i][j+1]);
        }
        for (j = 0; j < i; j++)
        {
            a[i-1][j] += a[i][j];
        }
    }
    printf("%d", a[0][0]);
    return 0;
}