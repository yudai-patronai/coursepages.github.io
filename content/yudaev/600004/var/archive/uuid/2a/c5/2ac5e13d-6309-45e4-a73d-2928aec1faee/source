#include <stdio.h>
unsigned pd[512][512];

unsigned p(int n, int m) {
        if( pd[n][m] != 0) {
                return pd[n][m];
        }
        if(m>n) return p(n, n);
        if(m <= 1 || n <= 1) return 1;
        return pd[n][m] = p(n-m, m) + p(n, m-1);
}

int main() {
        int n, i, j;
        scanf("%d", &n);
        for( i = 0 ; i <= n ; i++)
                for( j =0 ; j <= n ; j++) pd[i][j] = 0;

        printf("%u\n", p(n,n));
        return 0;
}
