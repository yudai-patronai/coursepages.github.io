#include <stdio.h>
#include <stdlib.h>

int max(int x1, int x2)
{
    if(x1 > x2)
        return x1;
    else
        return x2;
}
int main()
{
    int A[120][120], N = 0, s = 0, d = 0, i = 0, j = 0, t = 0;
    scanf("%i", &N);
    scanf("%i", &A[0][0]);
    for(i = 1; i < N; i++)
    {
        scanf("%i", &s);
        A[i][0] = A[i - 1][0] + s;

        for(t = 1; t <= i; t++)
        {
            scanf("%i", &s);
            A[i][t] = max(A[i-1][t-1],A[i-1][t]) + s;
        }
        A[i][i+1] = 0;
    }
    for(t = 0; t < i; t++)
    {
        if(A[i-1][t] > d)
            d = A[i-1][t];
    }
    printf("%i", d);
    return 0;
}

