#include <stdio.h>
int min(int a, int b)
{
	if(a <= b)
	{
		return a;
	}
	else
	{
		return b;
	}
}
int main()
{
	int buyers[6000];
	int n, i, ai, bi, ci;
	scanf("%d", &n);
	buyers[0] = 0;
	for(i = 1; i != n + 3; i++)
	{
		buyers[i] = 3601;
	}
	for(i = 1; i != n + 1; i++)
	{
		scanf("%d %d %d", &ai, &bi, &ci);
		buyers[i] = min(buyers[i], buyers[i - 1] + ai);
		buyers[i + 1] = min(buyers[i + 1], buyers[i - 1] + bi);
		buyers[i + 2] = min(buyers[i + 2], buyers[i - 1] + ci);
	}
	printf("%d", buyers[n]);
	return 0;
}
