#include <stdio.h>
#define MAX 101
int init(int d[MAX][MAX], int n)
{
    d[0][0] = 1;
    d[1][1] = 1;
    int i, j;
    for(i = 1; i <= n; i++)
    {
        d[i][0] = 0;
    }
    for(i = 0; i <= n; i++)
    {
        for(j = 1; j <= i; j++)
        {
            if((i - j < j)) d[i][j] = d[i][j - 1] + d[i - j][i - j];
            else d[i][j] = d[i][j - 1] + d[i - j][j];
        }
    }
    return 0;
}

int main()
{
 int N;
 int d[MAX][MAX];
 scanf("%d", &N);
 init(d, N);
 printf("%d", d[N][N]);
 return 0;
}
