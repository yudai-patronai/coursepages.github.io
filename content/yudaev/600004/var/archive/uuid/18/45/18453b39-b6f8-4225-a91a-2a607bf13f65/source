#include <stdio.h>

int main()
{
	long long int N[101][101];
	int i=0, j=0;
	for (i=0;i<101;i++) for(j=0;j<101;j++) N[i][j]=1;
	int n=0;
	scanf("%d", &n);
	for (i=2;i<=n;i++)
	{
		for (j=2;j<=i;j++)
		{
			if (i-j>=j) N[i][j]=N[i][j-1]+N[i-j][j];
			else N[i][j] = N[i][j-1]+N[i-j][i-j];
		}
	}
	printf("%lld", N[n][n]);
	return 0;
}
