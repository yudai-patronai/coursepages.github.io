#include <stdio.h>
#include <stdlib.h>
#define UNKNOWN -1
#define SIZE 5000
int main()
{
    int i, j, N, time[SIZE], queue = 0, tickets[SIZE][3];
    scanf("%d", &N);
    for (i = 0; i < SIZE; i++)
        time[i] = UNKNOWN;
    for (i = 0; i < N; i++)
        scanf("%d %d %d", &tickets[i][0], &tickets[i][1], &tickets[i][2]);
    for (i = 0; i < N; i++)
    {
        for (j = 0; j <= 2; j++)
        {
            if (((tickets[i][j] + queue) < time[i+j]) || (time[i+j] == UNKNOWN))
                time[i+j] = tickets[i][j] + queue;

        }
    queue = time[i];
    }
    printf("%d", time[N-1]);

    return 0;
}