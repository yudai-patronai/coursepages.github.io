#include <stdio.h>

int a[100];
int sum = 0;

void dec(int n, int k, int i) {
  if ( n < 0 ) return 0;
  if ( n == 0 ) {
    sum = sum + 1;
  } else {
    if ( n - k >= 0) {
      a[i] = k;
      dec(n - k, k, i + 1);
    }
    
    if ( k - 1 > 0) { 
      dec(n, k - 1, i);
    }
  }
  return 0;
}

int main() {
  int n, i;
  scanf("%d", &n);
  for (i = 0; i <= n; i = i + 1) {
    a[i] = 0;
  }
  dec(n, n, 0);
  printf ("%d", sum);
  return 0;
}