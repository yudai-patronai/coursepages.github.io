#define _CRT_SECURE_NO_WARNINGS
#include <stdio.h>
#include <malloc.h>
int main() {
	int N, M, i, j;
	scanf("%d%d", &N, &M);
	unsigned long int *p = (unsigned long int *)malloc((N + 1) * sizeof(unsigned long int));
	unsigned long int *a = (unsigned long int *)malloc((N + 1) * sizeof(unsigned long int));
	for (i = 0; i < N + 1; i++)
		p[i] = 1;
	for (j = 0; j < M; j++) {
		a[0] = 1;
		for (i = 1; i < N + 1; i++) {
			a[i] = a[i - 1] + p[i];
		}
		for (i = 0; i < N + 1; i++) {
			p[i] = a[i];
		}
	}
	printf("%lu", a[N]);
	free(p);
	free(a);
	return 0;
}