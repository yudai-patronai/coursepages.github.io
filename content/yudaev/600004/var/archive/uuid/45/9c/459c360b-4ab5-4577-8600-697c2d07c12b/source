

#include <stdio.h>


int main()
{
	long long int A[5008];
	int n = 0, i = 0;
	int a = 0, b = 0, c = 0;
	scanf("%d", &n);
	A[n] = 0;
	for (i = 0; i <= n+5; i++)
	{
		A[i] = 0;
	}
	for (i = 0; i < n; i++)
	{
		scanf("%d", &a);
		scanf("%d", &b);
		scanf("%d", &c);
		if ((A[i] + a < A[i + 1]) || A[i + 1] == 0) A[i + 1] = A[i] + a;
		if ((A[i] + b < A[i + 2]) || A[i + 2] == 0) A[i + 2] = A[i] + b;
		if ((A[i] + c < A[i + 3]) || A[i + 3] == 0) A[i + 3] = A[i] + c;
	}
	printf("%lld", A[n]);
	return 0;
}

