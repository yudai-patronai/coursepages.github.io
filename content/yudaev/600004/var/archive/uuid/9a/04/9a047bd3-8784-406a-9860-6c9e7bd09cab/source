#include <stdio.h>
#include <stdlib.h>

int main()
{
    int m, n;
    int i;
    int j;
    scanf("%d %d", &n, &m);
    n++;
    m++;
    int** p = (int**)malloc(n * sizeof(int*));
    for (i = 0; i < n; i++)
        p[i] = (int*)malloc(m * sizeof(int));
    p[0][0] = 1;
    for (i = 0; i < n; i++)
        for (j = 0; j < m; j++)
            if (i > 0 || j > 0)
                if (j > 0 && i > 0)
                    p[i][j] = p[i-1][j] + p[i][j-1];
                else
                    if (i > 0)
                        p[i][j] = p[i-1][j];
                    else
                        p[i][j] = p[i][j-1];

    printf("%d", p[n-1][m-1]);

    free(p);
    return 0;
}
