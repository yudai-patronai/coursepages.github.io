#include <stdlib.h>
#include <stdio.h>

int mas[102][102];
int nat(int m, int n);

int main() {
	int x;
	int i = 1, j = 1;
	for (i = 1; i <= 100; i++) {
		for (j = 1; j <= 100; j++) {
			mas[i][j] = 0;
		}
	}

	int ii = 1, jj = 1;
	for (ii = 1; ii <= 100; ii++) {
		for (jj = 1; jj <= 100; jj++) {
			mas[ii][jj] = nat(ii, jj);
		}
	}

	scanf("%i", &x);

	printf("%d\n", nat(x, x));

	return 0;
}
int nat(int m, int n) {
	if (n == 0) {
		if (m == 0) return 1;
		else return 0;
	}
	if (mas[m][n] != 0) {
		return mas[m][n];
	}
	int d = 0;
	if (n <= m) {
		d = nat(m, n - 1) + nat(m - n, n);
	}
	else d = nat(m, m);
	return d;
}