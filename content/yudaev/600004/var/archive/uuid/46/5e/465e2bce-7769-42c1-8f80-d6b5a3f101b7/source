#include <stdio.h>

#define min(a,b) (a) < (b) ? (a) : (b)

int main()
{   int A[5000] , B[5000][3] , N , u = 0 , i ;


    scanf( "%d" , & N ) ;



    for (i = 0 ; i < N ; i++)
    {
        for ( u = 0 ; u < 3 ; u++)

        {
            scanf( "%d" , & B[i][u] );
        }

    }
    A[0] = B[0][0] ;
    if (A[0] + B [1][0] < B[0][1]  )
        A[1] = A[0] + B [1][0] ;
    else
        A[1] = B[0][1];

    A[2] = min(  A[1] + B[2][0] , A[0] + B[1][1] );
    A[2] = min ( A[2] , B[0][2]);



    for(i = 3 ; i < N ; i++)
    {
        A[i] = A[i - 1] + B[i-1][0];
        if (A[i] > A [i - 2] + B[i-1][1])
            A[i] = A [i - 2] + B[i-1][1];
        if (A[i] > A [i - 3] + B[i-2][2])
            A[i] = A [i - 3] + B[i-2][2];
    }



    printf("%d " , A[N-1] );



    return 0;
}
