

#include <stdio.h>


int main()
{
	int A[22][22] = {0};
	A[0][1] = 1;
	int n = 0, m = 0;
	int i = 0, j = 0;
	scanf("%d", &n);
	scanf("%d", &m);
	for (i = 1; i <= n+1; i++)
	{
		for (j = 1; j <= m+1; j++)
		{
			A[i][j] = A[i - 1][j] + A[i][j - 1];
		}
	}
	printf("%d", A[n+1][m+1]);
	return 0;
}

