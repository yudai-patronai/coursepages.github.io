#include <stdio.h>
#include <stdlib.h>
#define max(a, b) (a) > (b) ? (a) : (b)
int tr[128][128], i, j, N, maxi=0;


int main()
{
    scanf("%d", &N);
    for(i = 0; i < 128; i++)
        for(j = 0; j < 128; j++)
            tr[i][j] = 0;
    for(i = 0; i < N; i++)
        for(j = 0; j < i+1; j++)
            scanf("%d", &tr[i][j]);
    for(i = 1; i < N; i++)
        tr[i][0] += tr[i-1][0];
    for(i = 0; i < N; i++)
        for(j = 1; j < i+1; j++)
        {
            tr[i][j] += max(tr[i-1][j-1], tr[i-1][j]);
        }
    for(j = 0; j < N; j++)
        if(tr[N-1][j] > maxi)
            maxi = tr[N-1][j];
    printf("%d", maxi);
    return 0;
}