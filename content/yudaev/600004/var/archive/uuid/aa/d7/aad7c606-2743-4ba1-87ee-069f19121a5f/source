#include <stdio.h>

int max(int a, int b)
{
	if (a > b)
		return a;
	return b;
}

int main()
{
	int n;
	scanf("%d", &n);
	int a[105][105];
	int i = 0;
	int j = 0;
	for (i = 0; i < n; i++)
	{
		for (j = 0; j < i + 1; j++)
		{
			scanf("%d", &a[i][j]);
		}
	}
	int z[105][105];
	z[0][0] = a[0][0];
	for (i = 0; i < n - 1; i++)
	{
		for (j = 0; j < i + 1; j++)
		{
			z[i + 1][j] = max(z[i + 1][j], a[i + 1][j] + z[i][j]);
			z[i + 1][j + 1] = max(z[i + 1][j], a[i + 1][j] + z[i][j]);
		}
	}
	int m = 0;
	for (i = 0; i < n; i++)
	{
		if (m < z[n - 1][i])
			m = z[n - 1][i];
	}
	printf("%d ", m);
	return 0;
}