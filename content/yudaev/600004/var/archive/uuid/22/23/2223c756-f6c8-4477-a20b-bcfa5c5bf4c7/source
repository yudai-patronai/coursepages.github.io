#include <stdio.h>

int p [100][100];

int main() {
	int i,k,n;
	scanf ("%d",&n);
	p[0][0] = 1;
	for (i = 1; i <= n; i++) {
		p[i][0] = 0;
	}
	for (i = 1; i <= n; i++) {
		p[0][i] = 1;
	}
	
	for (k = 1; k <= n; k++) {
		for (i = 1; i<=n; i++) {
			if (k > i) {
				p[i][k] = p [i][k-1]; 
			}
			if (k <= i) {
				p[i][k] = p[i][k-1] + p[i-k][k]; 
			}
		}
	}
	printf ("%d", p[n][n]);
	
	
    return 0;
}