#include <stdio.h>
int main()
{
    int n = 0;
    int i = 0;
    long long int a, b, c;
    long long int d[6000] = {};
    scanf ( "%d", &n );
    for ( i  = 1; i <= n + 2; i++ )
        d[i] = n * 3601;
    for ( i = 1; i <= n; i++ )
    {
        scanf ( "%lli %lli %lli", &a, &b, &c );
        d[i] = d[i] <= d[i - 1] + a  ? d[i] : d[i - 1] + a;
        d[i + 1] = d[i + 1] <= d[i - 1] + b ? d[i] : d[i - 1] + b;
        d[i + 2] = d[i + 2] <= d[i - 1] + c ? d[i] : d[i - 1] + c;
    }
    printf ( "%lli", d[n] );
    return 0;
    
    
    
}