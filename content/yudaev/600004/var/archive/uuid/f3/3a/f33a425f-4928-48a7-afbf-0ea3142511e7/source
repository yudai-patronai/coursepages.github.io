#include <stdio.h>

int main()
{
    int n = 0, m = 0;
    // int c = 0, b = 0;
    int i = 0, j = 0, max = 0;
    long long int sum  = 0;
    long long int  a[100][100] = {};
    scanf ( "%d", &n );
    //a[0][0] = 1;
    //printf ( "%d\n", a[0][0] );
    m = 2;
    scanf ( "%lli", &( a[0][0] ) );
    max  = 0;
    sum = a[0][0];
    for ( i = 1; i < n; i++ )
    {
        for ( j = 0; j < m; j++ )
        {   
            scanf ( "%lli", &( a[i][j] ) );
            
        }
    if ( a[i][max] >= a[i][max+1] )
    {
        sum += a[i][max];
    }
    else 
    {
        sum += a[i][max + 1];
        max = max + 1; 
    }
    m++;
       
    }
    
    printf ( "%lli", sum);
    return 0;
}