#include <stdio.h>
#include <string.h>
#include <stdlib.h>

int minim (int a, int b)
{
    if (a<b)
        return a;
    else return b;
}

int main()
{
    int n;
    scanf("%d", &n);
    int * a = (int *) malloc (n * sizeof(int));
    int * b = (int *) malloc (n * sizeof(int));
    int * c = (int *) malloc (n * sizeof(int));
    int i;
    for (i = 0; i < n; i++)
    {
        scanf("%d", &a[i]);
        scanf("%d", &b[i]);
        scanf("%d", &c[i]);
    }
    int * r = (int *) malloc ((n + 1) * sizeof(int));
    //r[k]- минимальное время, которое нужно, чтобы продать билеты k людям из очереди;
    r[1] = a[0];
    r[2] = minim (r[1] + a[1], b[0]);
    r[3] = minim (minim (r[2] + a[2], r[1] + b[1]), c[0]);
    for (i = 4; i <= n; i++)
    {
        r[i] = minim (r[i-3] + c[i-3], minim (r[i-2] + b[i-2], r[i-1] + a[i-1]));
    }
    printf("%d", r[n]);
    free(r);
    free(a);
    free(b);
    free(c);
    return 0;
}
