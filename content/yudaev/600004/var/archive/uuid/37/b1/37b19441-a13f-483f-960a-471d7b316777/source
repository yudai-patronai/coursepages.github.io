#include <stdio.h>
#define K 21

int main() {
	long a[K][K];
	int n, m, i, j;
	scanf("%d %d", &n, &m);
	for (i = 0; i <= n || i <= m; i++) {
		a[i][0] = 1;
		a[0][i] = 1;
	}
	for (i = 1; i <= n; i++) {
		for (j = 1; j <= m; j++) {
			a[i][j] = a[i][j-1] + a[i-1][j];
		}
	}
	printf("%ld", a[n][m]);
	return 0;
}
