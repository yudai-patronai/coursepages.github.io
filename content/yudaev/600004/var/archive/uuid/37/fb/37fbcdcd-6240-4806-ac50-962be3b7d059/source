#include <stdio.h>

#define N 22

unsigned long long int a[N][N];

int main()
{
        int i,j, m, n;
        scanf("%d", &n);
        scanf("%d", &m);
        n+=2, m+=2;
        a[0][1]=1;
        for (i=1;i<n;i++)
                for(j=1;j<m;j++)
                        a[i][j]=a[i-1][j]+a[i][j-1];

        // for (i=0; i<n; i++) {
                // for (j=0; j<m; j++)
                        // printf("%12llu ", a[i][j]);
                // putchar('\n');
        // }
        printf("%llu\n", a[n-1][m-1]);
        return 0;
}