#include <stdio.h>
#include <stdlib.h>

#define min(a, b) (a) < (b) ? (a) : (b)

int ms[8192], times[8192][3], n, i;

int main()
{
    for(i = 0; i < 5001; i++)
    {
        times[i][0] = 99990;
        times[i][1] = 99990;
        times[i][2] = 99990;
    }
    scanf("%d", &n);
    for(i = 0; i < n; i++)
    {
        scanf("%d %d %d", &times[i][0], &times[i][1], &times[i][2]);
        ms[i] = -1;
    }

    ms[0] = times[0][0];
    ms[1] = min(times[0][1], ms[0] + times[1][0]);
    i = 2;
    if((ms[i] > ms[i-1] + times[i][0]) || (ms[i] == -1))
        ms[i] = ms[i-1] + times[i][0];
    if(ms[i] > ms[i-2] + times[i-1][1])
        ms[i] = ms[i-2] + times[i-1][1];
    if(ms[i] > 0 + times[i-2][2])
        ms[i] = 0 + times[i-2][2];

    for(i = 3; i < n; i++)
    {
        if((ms[i] > ms[i-1] + times[i][0]) || (ms[i] == -1))
            ms[i] = ms[i-1] + times[i][0];
        if(ms[i] > ms[i-2] + times[i-1][1])
            ms[i] = ms[i-2] + times[i-1][1];
        if(ms[i] > ms[i-3] + times[i-2][2])
            ms[i] = ms[i-3] + times[i-2][2];
    }
    i++;
    if(ms[i] > ms[i-2] + times[i-1][1])
        ms[i] = ms[i-2] + times[i-1][1];
    if(ms[i] > ms[i-3] + times[i-2][2])
        ms[i] = ms[i-3] + times[i-2][2];
    i++;
    if(ms[i] > ms[i-3] + times[i-2][2])
        ms[i] = ms[i-3] + times[i-2][2];
    printf("%d", ms[n-1]);
    return 0;
}
