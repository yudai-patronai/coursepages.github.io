#include <stdio.h>

int main() {

    long long dp[30][30];
    int width, height;
    int i,j;
    scanf("%d%d", &width, &height);
    ++width;
    ++height;

    for(i = 0; i < width; ++i)
        dp[0][i] = 1;
    for(i = 0; i < height; ++i)
        dp[i][0] = 1;

    for(i = 1; i < height; ++i)
        for(j = 1; j < width; ++j)
            dp[i][j] = dp[i-1][j] + dp[i][j-1];

    printf("%lld\n", dp[height-1][width-1]);

    return 0;

}
