#include <stdio.h>


int r (int x, int y, long long int *N)
{
	int i=0;
	long long int s=0;
	if (x<=y) return N[x];
	else
 {
		for (i=y;i>0;i--)
		{
			s=s+r(x-i,i, N);
		}
		return s;
	}
}

int main()
{
	long long int N[101]={0};
	int n=0;
	N[1]=1;
	scanf("%d", &n);
	int i=0;
	for (i=2;i<=n;i++)
	{
		N[i]=1+r(i,i-1, N);
	}
	printf("%lld", N[n]);
	return 0;
}
