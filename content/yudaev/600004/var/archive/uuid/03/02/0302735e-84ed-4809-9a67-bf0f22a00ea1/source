#include <stdio.h>
#include <stdlib.h>

int main()
{
    int n,i, A, B, C;
    scanf("%i", &n);
    int *p = calloc(n+3, sizeof(int));
    for(i = 0; i < n+3;i++)
    p[i] = 0;
    scanf("%i %i %i", &p[0], &p[1], &p[2]);
    for(i = 0; i < n-1; i++)
    {
        scanf("%i %i %i", &A, &B, &C);
        if(i == n-2)
        {
            if(p[i] + A < p[i+1])
                p[i+1] = p[i] + A;
        }
        if(i <= n-3)
        {
            if((p[i] + B <= p[i+2]) && (p[i] + A <= p[i+1]))
            {
                p[i+1] = p[i] + A;
                p[i+2] = p[i] + B;
                p[i+3] = p[i] + C;
            }
        }

    }
    printf("%i", p[n-1]);
    free(p);
    return 0;
}
