#include <stdio.h>
#include <stdlib.h>
unsigned long long ways(int n, int m)
{
	int i, j;
	unsigned long long *p, a;
	p = (unsigned long long*)malloc((n + 1)*(m + 1)*sizeof(unsigned long long));
	for (j = 0; j < m+1; j++)
	{
		p[j] = 1;
	}
	for (j = 0; j < n+1; j++)
	{
		p[j*(m+1)] = 1;
	}
	for (i = 1; i < n+1; i++)
	{
		for (j = 1; j < m+1; j++)
		{
			p[i*(m+1) + j] = p[(i - 1)*(m+1) + j] + p[i*(m+1) + j - 1];
		}
	}
	a = p[(n+1)*(m+1)-1];
	free(p);
	return a;
}
int main()
{
	int N, M;
	scanf("%d%d", &N, &M);
	printf("%llu", ways(N, M));
	return 0;
}