m,n,k=tuple(int(i) for i in input().split())
mine=[[int(value)-1 for value in input().split()] for line in range(k)]
f=[[0]*n for i in range(m)]
for i in mine:
	f[i[1]][i[0]]=-1
	for x in range(max(0,i[0]-1),min(n,i[0]+2)): #possibly +1
		for y in range(max(0,i[1]-1),min(m,i[1]+2)):
			if f[y][x]!=-1:
				f[y][x]+=1
print('\n'.join([' '.join([str(j) if j>=0 else '*' for j in i]) for i in f]))