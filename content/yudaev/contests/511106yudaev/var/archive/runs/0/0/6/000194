N,M,K=list(map(int,input().split()))
C=[]
A=[]
B=[]
for x in range(K):
    A,B=list(map(int,input().split()))
    A=[A,B]
    C+=[A]
    A=[]
    B=[]
G=[]
T=[]
for x in range(N):
    T=[0]*M
    G+=[T]
    T=[]
e=0
for x in range(len(G)):
    for y in range(len(G[0])):
        if C!=[] and x==C[e][0]-1 and y==C[e][1]-1:
            G[x][y]='*'
            if e+1!=len(C):
                e+=1
k=len(G)
t=len(G[0])
for x in range(k):
    for y in range(t):
        if G[x][y]=='*':
            if x+1!=k and G[x+1][y]!='*':
                G[x+1][y]+=1
            if y+1!=t and G[x][y+1]!='*':
                G[x][y+1]+=1
            if x!=0 and G[x-1][y]!='*':
                G[x-1][y]+=1
            if y!=0 and G[x][y-1]!='*':
                G[x][y-1]+=1
            if x+1!=k and y+1!=t and G[x+1][y+1]!='*':
                G[x+1][y+1]+=1
            if x!=0 and y+1!=t and G[x-1][y+1]!='*':
                G[x-1][y+1]+=1
            if x+1!=k and y!=0 and G[x+1][y-1]!='*':
                G[x+1][y-1]+=1
            if x!=0 and y!=0 and G[x-1][y-1]!='*':
                G[x-1][y-1]+=1
for x in range(len(G)):
    for y in range(len(G[0])):
        G[x][y]=str(G[x][y])
for x in range(len(G)):
    print(' '.join(G[x]))