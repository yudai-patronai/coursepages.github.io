n, m = input().split()
n, m = int(n), int(m)
A = []
for i in range(n):
        A.append([int(x) for x in input().split()])
i, j = input().split()
i, j = int(i), int(j)

def SwapColumns(A, i, j):
    t1 = i
    t2 = j
    m = len(A[0])
    n = len(A)
    B = []
    #print (i, j)
    for i in range(n):
        B.append([])
        for j in range(m):
            B[i].append('.')
    for k in range (n):
        B[k][t1] = A[k][t2]
        B[k][t2] = A[k][t1]
    #print (B)
    for i in range (n):
        for j in range (m):
            if j != t1 and j != t2:
                B[i][j] = A[i][j]
    for row in B:
        for elem in row:
            print(elem, end=' ')
        print()


SwapColumns(A, i, j)