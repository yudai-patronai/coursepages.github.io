n = int(input())
a=[['.'for g in range(n)] for i in range(n)]
for i in range(n):
    a[i][n//2]='*'
for i in range(n):
    a[n//2][i]='*'
c=n-1
while c>-1:
    a[c][c]='*'
    c-=1
o=0
c=n-1
while c>-1:
    a[o][c]='*'
    c-=1
    o+=1

for row in a:
    print(' '.join([str(elem) for elem in row]))