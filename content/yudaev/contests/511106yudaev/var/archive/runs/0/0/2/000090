def arrayOutput(Arr):
    for j in range(len(Arr)):
        print(' '.join(map(str, Arr[j])))

nums = list(map(int, input().split()))
arr = [['.' for j in range(nums[1])] for i in range(nums[0])]
for i in range(nums[0]):
    for j in range(nums[1]):
        if i%2 == 0 and j%2 == 1:
            arr[i][j] = '*'
        elif i%2 == 1 and j%2 == 0:
            arr[i][j] = '*'
arrayOutput(arr)