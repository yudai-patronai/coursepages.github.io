def Rotate(a):
	for i in range(len(a)):
		for j in range(i,len(a)):
			a[i][j],a[j][i]=a[j][i],a[i][j]
	for j in range(len(a)//2):
		for i in range(len(a)):
			a[i][j],a[i][len(a)-1-j]=a[i][len(a)-1-j],a[i][j]
	
n=int(input())
a=[0]*n
for i in range(n):
	a[i]=[0]*n
for i in range(n):
	b=list(map(int,input().split()))
	for j in range(n):
		a[i][j]=b[j]
Rotate(a)
for i in range(n):
	print (' '.join(map(str,a[i])))