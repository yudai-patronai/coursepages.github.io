b=input()
b=b.split()
a=[[' ']*int(b[1]) for i in range(int(b[0]))]
for i in range (int(b[2])):
    s=input()
    s=s.split()
    a[int(s[0])-1][int(s[1])-1]='*'
for i in range (int(b[0])):
    for j in range (int(b[1])):
        if a[i][j]!='*':
            c=0
            for k in range (3):
                if i-1>=0 and j-1+k>=0 and j-1+k<=int(b[1])-1 and a[i-1][j-1+k]=='*':
                    c+=1
            for k in range (3):
                if i+i<=int(b[0])-1 and j+1-k>=0 and j-1+k<=int(b[1])-1 and a[i+1][j-1+k]=='*':
                    c+=1
            for k in range (2):
                if  j+1-k>=0 and j-1+k<=int(b[1])-1 and a[i][j-1+k]=='*':
                    c+=1
            a[i][j]=str(c)
for i in range (int(b[0])):
    print(' '.join(a[i]))
