n=int(input())
a=[list(map(int, input().split())) for p in range(n)]

def IsSymmetric(A):
    n=len(A)

    for i in range(1,n):
       for u in range(i,n):
          if A[u-i][u]!=A[u][u-i]:
              return False

    return True

if IsSymmetric(a):
    print('YES')
else:
    print('NO')