n = int(input())
for i in range(n):
    for j in range(n):
        if i == j:
            print('*', end = ' ')
        elif i == (n-j-1):
            print('*', end = ' ')
        elif i == (n-1)//2:
            print('*', end = ' ')
        elif j == (n-1)//2:
            print('*', end = ' ')
        else:
            print('.', end = ' ')
    print()