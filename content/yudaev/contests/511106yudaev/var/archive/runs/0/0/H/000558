n = int(input())
l = [[None] for a in range(n)]
for s in range(len(l)):
    l[s] = list(map(int, input().split()))


def Rotate(A):
    for i in range(len(A) // 2):
        for j in range(i,len(A)-i-1):
            A[i][j], A[j][len(A)-1-i], A[len(A) - 1 - i][len(A) - 1 - j], A[len(A) - 1 - j][i] \
            = A[len(A) - 1 - j][i], A[i][j], A[j][len(A) - 1 - i], A[len(A) - 1 - i][len(A) - 1 - j]


Rotate(l)
for z in l:
    print(*z)