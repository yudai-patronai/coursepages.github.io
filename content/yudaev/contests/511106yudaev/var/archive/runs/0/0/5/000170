N = int(input())
a = N//2
C = []
C = [['.' for j in range (N)] for i in range (N)]

for i in range (N):
    for j in range(N):
        if (j==i) or i==(N-j-1):
            C[i][j] = '*'
        if (j==a) or (i==a):
            C[i][j] = '*'
for row in C:
    print(' '.join([str(elem) for elem in row]))