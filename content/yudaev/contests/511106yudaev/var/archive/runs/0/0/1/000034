def SwapColumns(a, i, j):
	for k in range (len(a)):
		a[k][i],a[k][j]=a[k][j],a[k][i]

n,m=map(int,input().split())
a=[0]*n
for i in range(n):
	a[i]=[0]*m
for i in range(n):
	b=list(map(int,input().split()))
	for j in range(m):
		a[i][j]=b[j]
i,j=map(int,input().split())
SwapColumns(a,i,j)
for i in range(n):
	print(' '.join(map(str,a[i])))