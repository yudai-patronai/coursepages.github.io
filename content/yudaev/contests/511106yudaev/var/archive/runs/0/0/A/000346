def IsSymmetric(A):
    for i in range(len(A)):
        for j in range(len(A)):
            if i == j:
                continue
            If A[i][j] != A[j][i]
                return 'NO'
    return 'YES'
n = int(input())
massive = [['' for i in range(n)] for j in range(n)]
for i in range(n):
    inp = input().split()
    for j in range(n):
        massive[i][j] = int(inp[j])
print(IsSymmetric(massive))