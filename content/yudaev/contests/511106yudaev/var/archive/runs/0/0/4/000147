s1=input()
n=int(s1[0])
m=int(s1[2])
z=0
A = []
for i in range(n):
    A.append(list(map(int, input().split())))
P = []
for i in range(m):
    P.append([0] * n)
i=0
while i<n:
    j=0
    while j<m:
        z=A[i][j]
        P[j][i]=z
        j+=1
    i+=1

for row in P:
    for elem in row:
        print(elem, end = ' ')
    print()