A = (input().split())
n = int(A[0])
m = int(A[1])
B = [0] * n
for i in range(n):
    B[i] = [0] * m
for i in range(n):
    B[i] = (input().split())
    for j in range(m):
        B[i][j] = int(B[i][j])
for i in range(m):
    for j in range(n):
        print(B[j][i], end = ' ')
    print()