num = int(input())
num -= 1
A = [list(map(int,input().split())) for k in range(num+1)]
def Rotate(A): 
    A = [[A[num - q][p] for q in range(num+1)] for p in range(num+1)]
    return (str(A)[2:-2].replace("[","").replace("],","\n").replace("'","").replace(" ","").replace(","," "))
print(Rotate(A))
