n, m = list(map(int,input().split()))
l = [[None] * m for a in range(n)]

for i in range(0, n, 2):
    for j in range(m):
        if j % 2 == 0:
            l[i][j] = '.'
        else:
            l[i][j] = '*'
            
for i in range(1, n, 2):
    for j in range(m):
        if j % 2 == 1:
            l[i][j] = '.'
        else:
            l[i][j] = '*'
            
for z in l:
    print(*z)
