A = input().split()
n = int(A[0])
m = int(A[1])

M = []
for i in range(n):
    M.append(['.'] * m)

for i in range(0, n, 2):
    for j in range(1, m, 2):
        M[i][j] = '*'

for i in range(1, n, 2):
    for j in range(0, m, 2):
        M[i][j] = '*'

for i in range(n):
    A = str()
    for j in range(m):
        A += M[i][j] + ' '
    print(A)