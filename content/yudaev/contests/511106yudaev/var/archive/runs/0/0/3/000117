s1=input()
n=int(s1[0])
m=int(s1[2])
max=-100000000000
imax=-1
jmax=-1
i=0
while i<n:
    A = list(map(int, input().split()))
    j=0
    while j<m:
        if A[j]>max:
            max=A[j]
            imax=i
            jmax=j
        elif A[j]==max:
            max=max
            imax=imax
            jmax=jmax

        j+=1
    i+=1
print(imax,jmax)


