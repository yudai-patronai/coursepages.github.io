A = (input().split())
n = int(A[0])
m = int(A[1])
k = int(A[2])
B = [0] * (n+2)
for i in range(n+2):
    B[i] = [-2] * (m+2)
for i in range(k):
    A = (input().split())
    B[int(A[0])][int(A[1])] = -1
for i in range(1,n+1):
    for j in range(1,m+1):
        if B[i][j] != -1:
            x = 0
            for q in range(i-1,i+2):
                for w in range (j-1, j+2):
                    if B[q][w] == -1:
                        x += 1
            B[i][j] = x
for i in range(1, n+1):
    for j in range(1, m+1):
        if B[i][j]==-1:
            print('*', end=' ')
        else:
            print(B[i][j],end=' ')
    print()