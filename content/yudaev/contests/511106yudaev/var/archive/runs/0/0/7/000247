def SwapColumns(A, i, j):
    
    for k in range(len(A)):
        A[k].insert(i, A[k][j])
        A[k].pop(j+1)
    for k in range(len(A)):
        #if j == 0
        A[k].insert(j+1, A[k][i+1])
        if j == 0:
            A[k].pop(i)
        A[k].pop(i+1)
    return A

