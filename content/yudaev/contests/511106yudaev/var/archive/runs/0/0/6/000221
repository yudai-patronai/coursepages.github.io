B=input().split()
n=int(B[0])
m=int(B[1])
k=int(B[2])
bomb=[]

for i in range(k):
     row=input().split()
     for i in range(2):
        row[i]=int(row[i])
     bomb.append(row) 

pole=[[0 for j in range(m)] for i in range(n)]
for i in range(k):
   pole[int(bomb[i][0])-1][int(bomb[i][1])-1]='*'

for i in range(k):
   x=int(bomb[i][0])
   y=int(bomb[i][1])
   for i in range(-1,2):
       for j in range(-1,2):
          if ((x-1+i)>=0 and (x-1+i)<=n-1) and ((y-1+j)>=0 and (y-1+j)<=m-1):
              if pole[x-1+i][y-1+j]!='*':
                   pole[x-1+i][y-1+j]+=1
     

   
 
for row in pole:
   print(' '.join([str(elem) for elem in row]))  