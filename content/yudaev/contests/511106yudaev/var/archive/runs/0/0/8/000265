b=int(input())
a=['']*b
for i in range (b):
    s=input()
    a[i]=s.split()
def rotate(a):
    c=[['']*len(a) for i in range(len(a))]
    for i in range(len(a)):
        for j in range(len(a)):
            c[i][j]=a[len(a)-1-j][i]
    for i in range(len(a)):
        print(' '.join(c[i]))
rotate(a)
