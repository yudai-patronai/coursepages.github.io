M=input().split() 
for z in range(len(M)): 
    M[z]=int(M[z]) 
stroki=M[0] 
stolbci=M[1] 
B = ['.'] * stroki 
for i in range(stroki): 
    B[i] = ['.'] * stolbci 
for i in range(1,stroki): 
    if B[i-1][0]=='.': 
        B[i][0]='*' 
    else: 
        B[i][0]='.' 
for i in range(stroki): 
    for j in range(1,stolbci): 
        if B[i][j-1]=='.': 
            B[i][j]='*' 
        else: 
            B[i][j]='.' 
for i in range(stroki): 
    print(' '.join(B[i]))