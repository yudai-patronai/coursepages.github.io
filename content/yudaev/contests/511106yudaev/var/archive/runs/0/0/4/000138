n=int(input())
A = []
for i in range(n):
    A.append(['.'] * n)
i=(n//2)
for j in range(n):
    A[i][j]='*'
j=n//2
for i in range(n):
    A[i][j]='*'
for i in range(n):
    for j in range(n):
        if i==j :
            A[i][j]='*'
for i in range(n):
    for j in range(n):
        if i+j==n-1:
            A[i][j]='*'
for row in A:
    for elem in row:
        print(elem, end = ' ')
    print()