M=input().split()
for z in range(len(M)):
    M[z]=int(M[z])
stroki=M[0]
stolbci=M[1]
B = [0] * stroki
for i in range(stroki):
    B[i] = [0] * stolbci
for i in range(stroki):
    A=input().split()
    for j in range(len(A)):
        A[j]=int(A[j])
        B[i][j]=A[j]
min=B[0][0]
stroka_min=0
stolbec_min=0
for i in range (stroki):
    for j in range(stolbci):
        if B[i][j]>min:
                min=B[i][j]
                stroka_min=i
                stolbec_min=j
print(stroka_min,stolbec_min, end=' ')