
def IsSymmetric(A):
    result=True
    for i in range(len(A)):
        for j in range(i+1,len(A)): 
            if A[i][j]!=A[j][i]: 
                result=False
                break 
        if result==False:
            break 
    return result

A=[]
n=int(input())
for row in range(n):
    A.append(list())
    A[row]=list(input().split())

print('YES' if IsSymmetric(A) else 'NO')
