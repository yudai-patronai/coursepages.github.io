n = int(input())
a = []
for i in range(n):
    a.append([int(j) for j in input().split()])

#a = [[5,2,2],[1,2,3],[2,3,4]]

def IsSymmetric(a):
    f = 1
    for i in range(n):
        for j in range(n):
            if a[i][j] != a[j][i]:
                f = 0
                break 
    
    return f
if IsSymmetric(a) == 1:
    print('YES')
else:
    print('NO')
