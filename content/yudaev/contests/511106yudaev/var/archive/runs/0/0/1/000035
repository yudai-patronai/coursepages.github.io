def IsSymmetric(a):
	for i in range (len(a)):
		for j in range(len(a)):
			if a[i][j]!=a[j][i]:
				return (False)
			else:
				return(True)
n=int(input())
a=[0]*n
for i in range(n):
	a[i]=[0]*n
for i in range(n):
	b=list(map(int,input().split()))
	for j in range(n):
		a[i][j]=b[j]
if IsSymmetric(a)==True:
	print('YES')
else:
	print('NO')