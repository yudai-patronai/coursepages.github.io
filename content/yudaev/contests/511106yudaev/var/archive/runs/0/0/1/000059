m,n,k=tuple(int(i) for i in input().split())
r_mines=[[int(value)-1 for value in input().split()] for line in range(k)]
mines=[]
for i in r_mines:
	if i not in mines: mines.append(i)
f=[[0]*n for i in range(m)]
for i in mines:
	f[i[0]][i[1]]='*'
	for y in range(max(0,i[0]-1),min(m,i[0]+2)): #possibly +1
		for x in range(max(0,i[1]-1),min(n,i[1]+2)):
			if f[y][x]!='*':
				f[y][x]+=1
print('\n'.join([' '.join([str(j) for j in i]) for i in f]))