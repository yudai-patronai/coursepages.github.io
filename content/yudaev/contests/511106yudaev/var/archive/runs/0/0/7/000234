n = int(input())

M = []
for i in range(n):
    M.append(['.'] * n)
    
for i in range(n): #первая диагональ
    M[i][i] = '*'
for i in range(n): #вторая диагональ
    M[i][n - i - 1] = '*'
for i in range(n): #горизонталь
    M[n//2][i] = '*'
for i in range(n): #вертикаль
    M[i][n//2] = '*'

for i in range(n):
    A = str()
    for j in range(n):
        A += M[i][j] + ' '
    print(A)